                float historicalCumulative = reportedZeroDay ? 0.0 : historicalAtClose ? historicalDailyVolume : pathUsable ? f_scaledHistoricalWindow(rvatIntraVols[i], rvatIntraStarts[i], rvatIntraEnds[i], historicalStart, historicalStart, historicalTarget, historicalEnd, historicalDailyVolume) : na

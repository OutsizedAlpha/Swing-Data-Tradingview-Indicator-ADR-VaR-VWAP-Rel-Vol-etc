            participationIntensity := 100.0 * hPeriodVolume / FSO
        dayRangePosition := hPeriodHigh > hPeriodLow ? 100.0 * (hPeriodClose - hPeriodLow) / (hPeriodHigh - hPeriodLow) : na
        directionalEfficiency := hPeriodHigh > hPeriodLow ? 100.0 * (hPeriodClose - hPeriodOpen) / (hPeriodHigh - hPeriodLow) : na
        float hReturn = price_impact_basis == 'Open to current' ? (hPeriodOpen > 0 ? 100.0 * (hPeriodClose / hPeriodOpen - 1.0) : na) : (hPreviousClose > 0 ? 100.0 * (hPeriodClose / hPreviousClose - 1.0) : na)
        priceImpactPerTurnover := not na(participationIntensity) and participationIntensity > 0 ? hReturn / participationIntensity : na
        bool hvMatches = not na(hVwapKey) and hVwapKey == hPeriodStart and not na(hVwapStart) and not na(hVwapEnd) and hVwapStart >= hPeriodStart and hVwapStart < hCutoff and hVwapEnd <= hPeriodEnd
        bool hvUsable = hvMatches and hVwapReady and not na(hVwap) and hVwap > 0 and not na(hVwapVolume) and hVwapVolume > 0
        sessionVWAP := hvUsable ? hVwap : na
        distanceFromVWAP := not na(sessionVWAP) ? 100.0 * (hPeriodClose / sessionVWAP - 1.0) : na
        sessionDollarVolume := not na(sessionVWAP) ? sessionVWAP * hPeriodVolume : na
        hCurrentDollarVolume := sessionDollarVolume
        float hFloatCapital = not na(FSO) and FSO > 0 ? FSO * hPeriodClose : na
        economicThroughput := not na(hFloatCapital) and hFloatCapital > 0 and not na(sessionDollarVolume) ? 100.0 * sessionDollarVolume / hFloatCapital : na
        if rvat_mode == 'Cumulative from open'
            rvatToday := hPeriodVolume
        else if hPathCompatible and hCalendarMatches and not na(hBlockLo)
            int currentStatus = f_hStatus(hVols, hStarts, hEnds, hCoordsA, hCoordsB, hNativeVols, hReady, hDayNumbers, hPeriodStart, hPeriodEnd, hDayCount, hCalendarReady)
            if currentStatus == 0
                // Use a single source for per-block numerator and its denominator.
                // Scale the CURRENT block by the observed period-volume coverage, not
                // by pretending unmatched daily-feed volume traded in the latest block.
                float rawThroughNow = array.sum(hVols)
                float rawBlock = f_hWindow(hVols, hCoordsA, hCoordsB, hBlockLo, hBlockHi)
                // Do not fractionate an already-developing source bar a second time.
                int curN = array.size(hVols)
                if curN > 0
                    int lastJ = curN - 1
                    int lastStart = array.get(hStarts, lastJ)
                    int lastEnd = array.get(hEnds, lastJ)
                    float lastA = array.get(hCoordsA, lastJ)
                    float lastB = array.get(hCoordsB, lastJ)
                    if lastStart < hCutoff and lastEnd > hCutoff and lastB > lastA and lastA >= hBlockLo
                        float fractionAlreadyCounted = math.max(0.0, math.min(lastB, hBlockHi) - math.max(lastA, hBlockLo)) / (lastB - lastA)
                        rawBlock += array.get(hVols, lastJ) * (1.0 - fractionAlreadyCounted)
                rvatToday := not na(rawThroughNow) and rawThroughNow > 0 and not na(rawBlock) ? hPeriodVolume * math.min(math.max(rawBlock / rawThroughNow, 0.0), 1.0) : na

        float sumRvat = 0.0
        float sumRvatFull = 0.0
        float belowFloat = 0.0
        float equalFloat = 0.0
        float belowVolume = 0.0
        float equalVolume = 0.0
        float sumRangeProgress = 0.0
        float sharePartSum = 0.0
        float shareFullSum = 0.0
        float dollarPartSum = 0.0
        float dollarFullSum = 0.0
        int scanTo = math.min(hScanLimit, bar_index)
        bool canCompare = hComplete or (hCalendarMatches and not na(hPosition) and hPosition > 0)
        if canCompare and scanTo > 0
            for i = 1 to scanTo
                bool wantRvat = rvatSampleCount < rvat_len and hPathCompatible
                bool wantFloat = participationCollectReported and participationReportedCount < participation_len and not na(participationIntensity)
                bool wantVolume = participationCollectVolume and participationVolumeCount < participation_len
                bool wantRange = adrPaceSampleCount < adr_pace_len
                bool wantShareProjection = hShareProjectionCount < len
                bool wantDollarProjection = hDollarProjectionCount < dollar_vol_len
                if not wantRvat and not wantFloat and not wantVolume and not wantRange and not wantShareProjection and not wantDollarProjection
                    break
                int ps = hPeriodStart[i]
                int pe = hPeriodEnd[i]
                if na(ps)
                    break
                hScanned := i
                float pv = hPeriodVolume[i]
                bool periodOK = not na(pe) and pe > ps and pe <= hPeriodStart and not na(pv) and pv >= 0
                if not periodOK
                    hBadPeriod += 1
                    continue
                int days = hDayCount[i]
                bool dayHistoryOK = hCalendarReady[i] and hCalendarKey[i] == ps and not na(days) and days > 0
                // Do not pad a short month/holiday week with zero future sessions.
                bool enoughDays = hComplete or (dayHistoryOK and float(days) + 0.0000001 >= hPosition)
                if not enoughDays
                    hTooShort += 1
                    continue
                bool zeroPeriod = pv == 0
                bool needPath = not hComplete or (wantRvat and rvat_mode == 'Per-block') or wantDollarProjection
                int status = needPath and not zeroPeriod ? f_hStatus(hVols[i], hStarts[i], hEnds[i], hCoordsA[i], hCoordsB[i], hNativeVols[i], hReady[i], hDayNumbers[i], ps, pe, days, dayHistoryOK) : 0
                bool pathOK = status == 0
                if status == 1
                    hNoPath += 1
                else if status == 2
                    hClipped += 1
                else if status == 3 or status == 4
                    hBadPath += 1
                else if status == 5
                    hBadDays += 1
                float fullRaw = pathOK and not zeroPeriod and needPath ? array.sum(hVols[i]) : na
                float target = hComplete ? float(days) : hPosition
                float rawPart = pathOK and not zeroPeriod and not hComplete ? f_hWindow(hVols[i], hCoordsA[i], hCoordsB[i], 0.0, target) : na
                float cumulative = zeroPeriod ? 0.0 : hComplete ? pv : not na(fullRaw) and fullRaw > 0 and not na(rawPart) ? pv * math.min(math.max(rawPart / fullRaw, 0.0), 1.0) : na
                if wantRvat
                    float observation = na
                    if rvat_mode == 'Cumulative from open'
                        observation := cumulative
                    else if pathOK and dayHistoryOK
                        // Completed periods compare the LAST block of their LAST session.
                        // Developing periods compare the same session ordinal/block.
                        float lastDaySeconds = float(hCalendarDayEnd[i] - hCalendarDayStart[i]) / 1000.0
                        float lastBlockSeconds = lastDaySeconds > 0 ? math.floor(math.max(lastDaySeconds - 0.001, 0.0) / float(rvat_block_min * 60)) * float(rvat_block_min * 60) : na
                        float lo = hComplete ? (lastDaySeconds > 0 ? float(days - 1) + lastBlockSeconds / lastDaySeconds : na) : hBlockLo
                        float hi = hComplete ? float(days) : hBlockHi
                        float raw = zeroPeriod ? 0.0 : f_hWindow(hVols[i], hCoordsA[i], hCoordsB[i], lo, hi)
                        observation := zeroPeriod ? 0.0 : not na(raw) and not na(fullRaw) and fullRaw > 0 ? pv * math.min(math.max(raw / fullRaw, 0.0), 1.0) : na
                    if not na(observation)
                        sumRvat += observation
                        sumRvatFull += pv
                        rvatSampleCount += 1
                        rvatOldestStart := ps
                        rvatOldestOffset := i
                        if na(rvatNewestStart)
                            rvatNewestStart := ps
                if wantFloat and not na(cumulative)
                    // FY snapshot is the provider value on the historical chart period.
                    // This is not a daily or publication-time ownership reconstruction.
                    float historicalFloat = floatFYSeries[i]
                    if not na(historicalFloat) and historicalFloat > 0
                        float ft = 100.0 * cumulative / historicalFloat
                        float tol = math.max(math.abs(participationIntensity), 1.0) * 0.0000001
                        if ft < participationIntensity - tol
                            belowFloat += 1.0
                        else if math.abs(ft - participationIntensity) <= tol
                            equalFloat += 1.0
                        participationReportedCount += 1
                        participationOldestStart := ps
                        participationOldestOffset := i
                        if na(participationNewestStart)
                            participationNewestStart := ps
                    else
                        hMissingFloat += 1
                if wantVolume and not na(cumulative)
                    float tol = math.max(math.abs(hPeriodVolume), 1.0) * 0.0000001
                    if cumulative < hPeriodVolume - tol
                        belowVolume += 1.0
                    else if math.abs(cumulative - hPeriodVolume) <= tol
                        equalVolume += 1.0
                    participationVolumeCount += 1
                    participationVolumeOldestStart := ps
                    participationVolumeOldestOffset := i
                    if na(participationVolumeNewestStart)
                        participationVolumeNewestStart := ps
                if wantRange and not zeroPeriod
                    float progress = na
                    if hComplete
                        progress := 1.0
                    else if pathOK
                        [hh, ll] = f_hHighLow(hHighs[i], hLows[i], hCoordsB[i], target)
                        float fullHigh = array.max(hHighs[i])
                        float fullLow = array.min(hLows[i])
                        if not na(hh) and not na(ll) and not na(fullHigh) and not na(fullLow) and fullHigh > fullLow
                            progress := math.min(math.max((hh - ll) / (fullHigh - fullLow), 0.0), 1.0)
                    if not na(progress) and progress > 0
                        sumRangeProgress += progress
                        adrPaceSampleCount += 1
                        adrOldestStart := ps
                        adrOldestOffset := i
                        if na(adrNewestStart)
                            adrNewestStart := ps
                    else
                        hNoRange += 1
                if wantShareProjection and not na(cumulative)
                    sharePartSum += cumulative
                    shareFullSum += pv
                    hShareProjectionCount += 1
                // Dollar averages/projections use estimated notional consistently:
                // intrabar HLC3 VWAP * the historical period-feed volume.
                if wantDollarProjection and pathOK
                    float fullDollar = na
                    float partDollar = na
                    if zeroPeriod
                        fullDollar := 0.0
                        partDollar := 0.0
                    else if not na(fullRaw) and fullRaw > 0
                        float rawDollarFull = array.sum(hPVs[i])
                        float rawDollarPart = hComplete ? rawDollarFull : f_hWindow(hPVs[i], hCoordsA[i], hCoordsB[i], 0.0, target)
                        if not na(rawDollarFull) and rawDollarFull > 0 and not na(rawDollarPart)
                            fullDollar := rawDollarFull * pv / fullRaw
                            partDollar := fullDollar * math.min(math.max(rawDollarPart / rawDollarFull, 0.0), 1.0)
                    if not na(fullDollar) and not na(partDollar)
                        dollarFullSum += fullDollar
                        dollarPartSum += partDollar
                        hDollarProjectionCount += 1

        if rvatSampleCount >= hAverageFloor
            rvatAverage := sumRvat / rvatSampleCount
            rvatHistoricalFullDayAvg := sumRvatFull / rvatSampleCount
            rvatHistoricalCompletion := rvatHistoricalFullDayAvg > 0 ? rvatAverage / rvatHistoricalFullDayAvg : na
        rvatRatio := not na(rvatToday) and not na(rvatAverage) and rvatAverage > 0 ? rvatToday / rvatAverage : na
        rvatValue := rvat_output == 'Difference (+/- %)' ? (not na(rvatRatio) ? 100.0 * (rvatRatio - 1.0) : na) : rvat_output == 'Index (100 = average)' ? (not na(rvatRatio) ? 100.0 * rvatRatio : na) : rvatRatio
        participationReportedPctile := participationReportedCount >= hRankFloor ? 100.0 * (belowFloat + 0.5 * equalFloat) / participationReportedCount : na
        participationVolumePctile := participationVolumeCount >= hRankFloor ? 100.0 * (belowVolume + 0.5 * equalVolume) / participationVolumeCount : na
        bool hAutoProxy = participation_basis == 'Auto (historical float; volume fallback)' and participationReportedCount < participation_len and participationVolumeCount > participationReportedCount and participationVolumeCount >= hRankFloor
        participationUsesVolumeProxy := participation_basis == 'Same-time volume only' or hAutoProxy
        participationPctile := participationUsesVolumeProxy ? participationVolumePctile : participationReportedPctile
        participationSampleCount := participationUsesVolumeProxy ? participationVolumeCount : participationReportedCount
        adrRangeProgressAvg := adrPaceSampleCount >= hAverageFloor ? sumRangeProgress / adrPaceSampleCount : na
        float hDirectional = hPeriodOpen > 0 ? 100.0 * (hPeriodClose / hPeriodOpen - 1.0) : na
        // The denominator is the average range of CHART PERIODS (weekly/monthly/etc.).
        adrPaceAtTime := not na(adrRangeProgressAvg) and adrRangeProgressAvg > 0 and arp > 0 ? hDirectional / (arp * adrRangeProgressAvg) : na
        if hShareProjectionCount >= hAverageFloor and shareFullSum > 0
            hShareAverage := shareFullSum / hShareProjectionCount
            hShareCompletion := sharePartSum / shareFullSum
        if hDollarProjectionCount >= hAverageFloor and dollarFullSum > 0
            hDollarAverage := dollarFullSum / hDollarProjectionCount
            hDollarCompletion := dollarPartSum / dollarFullSum
        hProjectedVolume := hComplete ? hPeriodVolume : not na(hShareCompletion) and hShareCompletion > 0 ? hPeriodVolume / hShareCompletion : na
        hProjectedDollarVolume := hComplete ? hCurrentDollarVolume : not na(hCurrentDollarVolume) and not na(hDollarCompletion) and hDollarCompletion > 0 ? hCurrentDollarVolume / hDollarCompletion : na

    // Existing rendering variables are populated with CURRENT-PERIOD values only.
    // The original daily engine did not execute on this chart; its history remains separate.
    rvatDailyOpen := hPeriodOpen
    rvatDailyHigh := hPeriodHigh
    rvatDailyLow := hPeriodLow
    rvatDailyClose := hPeriodClose
    rvatDailyVolume := hPeriodVolume
    rvatCutoff := hCutoff
    currentSessionStart := hPeriodStart
    currentSessionEnd := hPeriodEnd
    rvatSessionUsable := hUsable
    advancedDailyReady := hPeriodValid
    rvatElapsedMinutes := not na(hCutoff) ? float(hCutoff - hPeriodStart) / 60000.0 : na
    rvatSessionProgress := hComplete ? 1.0 : na
    rvatRequiredSamples := hAverageFloor
    participationRequiredSamples := hRankFloor
    adrRequiredSamples := hAverageFloor
    historyScanned := hScanned
    historyBadDaily := hBadPeriod
    historyShortSessions := hTooShort
    historyNoIntrabars := hNoPath
    historySourceBoundary := hClipped
    historyMalformed := hBadPath
    historyMissingFloat := hMissingFloat
    historyNoRange := hNoRange
    // Use the same aliases for the audited native VWAP display, not the daily anchor.
    vwapNativeValue := hVwap
    vwapNativeVolume := hVwapVolume
    vwapNativeSession := hVwapKey
    vwapNativeBarStart := hVwapStart
    vwapNativeBarEnd := hVwapEnd
    vwapNativeClose := hVwapClose
    vwapNativeReady := hVwapReady

rvatLabel = rvat_mode == 'Cumulative from open' ? 'Rel. Vol@Time (cumul)' : 'Rel. Vol@Time (' + rvat_block + ' blk)'
rvatText = rvat_output == 'Difference (+/- %)' ? f_signedPct(rvatValue, '0') : rvat_output == 'Index (100 = average)' ? (na(rvatValue) ? '-' : str.tostring(rvatValue, '0') + '%') : (na(rvatValue) ? '-' : str.tostring(rvatValue, '0.00') + 'x')
string rvatDisplayText = rvatText + (not na(rvatValue) and rvatSampleCount < rvat_len ? ' (n=' + str.tostring(rvatSampleCount) + ')' : '')
string adrPaceDisplayText = not na(adrPaceAtTime) ? f_signedNumber(adrPaceAtTime, '0.00', 'x ADR') + (adrPaceSampleCount < adr_pace_len ? ' (n=' + str.tostring(adrPaceSampleCount) + ')' : '') : '-'
string sameTimeWindowText = advancedDailyReady and not na(rvatCutoff) ? str.format_time(currentSessionStart, 'HH:mm', syminfo.timezone) + '-' + str.format_time(rvatCutoff, 'HH:mm', syminfo.timezone) + ' exchange time; ' + str.tostring(rvatElapsedMinutes, '0.0') + ' minutes / ' + str.tostring(100.0 * rvatSessionProgress, '0.0') + '% of session' : '-'
string completionText = not na(rvatHistoricalCompletion) ? str.tostring(100.0 * rvatHistoricalCompletion, '0.0') + '%' : '-'
string completionDescription = rvat_mode == 'Cumulative from open' ? 'Historical volume normally completed by this point' : 'Historical full-day volume represented by this matching block'
string adrProgressText = not na(adrRangeProgressAvg) ? str.tostring(100.0 * adrRangeProgressAvg, '0.0') + '%' : '-'
string historyDiagnostics = 'Inspected ' + str.tostring(historyScanned) + '/' + str.tostring(sameTimeScanLimit) + ' prior bars while filling independent samples. Exclusions: invalid daily/session=' + str.tostring(historyBadDaily) + ', ended before target=' + str.tostring(historyShortSessions) + ', no intrabars=' + str.tostring(historyNoIntrabars) + ', first/clipped source day=' + str.tostring(historySourceBoundary) + ', malformed arrays=' + str.tostring(historyMalformed) + ', source-volume mismatch=' + str.tostring(historyCumulativeMismatch) + ', missing historical float=' + str.tostring(historyMissingFloat) + ', no usable range yet=' + str.tostring(historyNoRange) + '. Valid sparse sessions accepted=' + str.tostring(historySparseAccepted) + '; valid zero same-time windows=' + str.tostring(historyZeroWindows) + '.'
string rvatSpanText = not na(rvatOldestStart) ? str.format_time(rvatOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(rvatNewestStart, 'yyyy-MM-dd', syminfo.timezone) + '; oldest observation ' + str.tostring(rvatOldestOffset) + ' daily bars back' : 'no valid observations'
string participationSpanText = not na(participationOldestStart) ? str.format_time(participationOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(participationNewestStart, 'yyyy-MM-dd', syminfo.timezone) + '; oldest observation ' + str.tostring(participationOldestOffset) + ' daily bars back' : 'no valid observations'
string participationVolumeSpanText = not na(participationVolumeOldestStart) ? str.format_time(participationVolumeOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(participationVolumeNewestStart, 'yyyy-MM-dd', syminfo.timezone) + '; oldest observation ' + str.tostring(participationVolumeOldestOffset) + ' daily bars back' : 'no valid observations'
string participationDisplayedSpanText = participationUsesVolumeProxy ? participationVolumeSpanText : participationSpanText
string participationRowLabel = participationUsesVolumeProxy ? 'Volume Pctl (' + str.tostring(participation_len) + ') [proxy]' : 'Part. Pctl (' + str.tostring(participation_len) + ') [FY est.]'
string adrSpanText = not na(adrOldestStart) ? str.format_time(adrOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(adrNewestStart, 'yyyy-MM-dd', syminfo.timezone) + '; oldest observation ' + str.tostring(adrOldestOffset) + ' daily bars back' : 'no valid observations'
string commonDataStatus = not (tfOneDay or tfIntraday) ? 'Advanced same-time metrics require a 1D chart.' : not advancedDailyReady ? 'Regular-session daily volume or session bounds unavailable.' : tfIntraday and (rvatSessionActive or rvatSessionComplete) and not iEngineAligned ? 'Requested 1D context is not aligned with the current daily session; no reading is published.' : not rvatSessionUsable or rvatElapsedMs <= 0 ? 'No usable regular-session time has elapsed.' : ''
string rvatDataStatus = commonDataStatus != '' ? commonDataStatus : not rvatResolutionCompatible ? 'Sampling resolution exceeds the per-block size.' : na(rvatToday) ? 'Current block prefix is unavailable or failed validation.' : rvatSampleCount < rvatRequiredSamples ? 'Fewer than 21 valid historical sessions; no reading is published.' : na(rvatAverage) ? 'Historical same-time average is unavailable or failed validation.' : rvatAverage == 0 ? 'Historical same-time mean is zero; a finite RVOL ratio is undefined.' : rvatSampleCount < rvat_len ? 'Adaptive partial sample; using all available valid sessions up to the selected maximum.' : 'Selected maximum sample is complete.'
string participationDataStatus = commonDataStatus
if commonDataStatus == ''
    if participationUsesVolumeProxy
        participationDataStatus := participationSampleCount < participationRequiredSamples ? 'Fewer than 63 valid same-time volumes; no percentile is published.' : participationSampleCount < participation_len ? 'Adaptive partial VOLUME-PROXY sample; using all available valid observations up to the selected maximum.' : participation_basis == 'Same-time volume only' ? 'Selected maximum same-time VOLUME sample; volume-only mode selected.' : 'Selected maximum VOLUME-PROXY sample selected because reported-float history is incomplete.'
    else
        participationDataStatus := na(participationIntensity) ? 'Current float is unavailable; reported-float turnover cannot be ranked.' : participationSampleCount < participationRequiredSamples ? 'Fewer than 63 valid reported-float observations; no percentile is published.' : participationSampleCount < participation_len ? 'Adaptive partial reported-float sample; missing float is not backfilled.' : 'Selected maximum reported-float sample; original turnover percentile is used.'
string adrDataStatus = commonDataStatus != '' ? commonDataStatus : adrPaceSampleCount < adrRequiredSamples ? 'Fewer than 21 valid range-development observations; no reading is published.' : adrPaceSampleCount < adr_pace_len ? 'Adaptive partial sample; using all available valid observations up to the selected maximum.' : 'Selected maximum sample is complete.'
rvatTooltip = 'Status: ' + rvatDataStatus + '\nCurrent selected-window volume: ' + f_compactNumber(rvatToday) + '. Historical same-time average: ' + f_compactNumber(rvatAverage) + '. Matched-sample full-day average: ' + f_compactNumber(rvatHistoricalFullDayAvg) + '. ' + completionDescription + ': ' + completionText + '. RVOL ratio: ' + (na(rvatRatio) ? '-' : str.tostring(rvatRatio, '0.00') + 'x') + '. Window: ' + sameTimeWindowText + '.\nUsable sessions: ' + str.tostring(rvatSampleCount) + '/' + str.tostring(rvat_len) + ' max (minimum ' + str.tostring(rvatRequiredSamples) + '). Sample: ' + rvatSpanText + '.\n' + historyDiagnostics + '\nHistorical intraday completion fractions are rescaled to that session’s daily volume, as in the attached version; this is an estimate, not an exact transaction-time reconstruction. Sampling: ' + rvat_intratf + ' min; request limit 100,000 intrabars.'
string participationMethodText = participationUsesVolumeProxy ? 'Displayed basis: cumulative regular-session VOLUME percentile [proxy], at the identical elapsed session time. This is a separate measure, NOT a reconstructed historical-float turnover percentile.' : 'Displayed basis: CURRENT volume / latest float ranked against historical same-time volume / reported FY float. The historical annual series is NOT publication-time-aligned, so this is an approximate live-monitoring metric, NOT a point-in-time historical backtest signal.'
string participationReportedAuditText = participationCollectReported ? 'Reported-FY-float sample: ' + str.tostring(participationReportedCount) + '/' + str.tostring(participation_len) + '; percentile ' + (na(participationReportedPctile) ? '-' : str.tostring(participationReportedPctile, '0.0') + 'th') + '. Sample: ' + participationSpanText + '.' : 'Reported-FY-float ranking is not collected in volume-only mode.'
string participationVolumeAuditText = participationCollectVolume ? 'Separate same-time volume sample: ' + str.tostring(participationVolumeCount) + '/' + str.tostring(participation_len) + '; percentile ' + (na(participationVolumePctile) ? '-' : str.tostring(participationVolumePctile, '0.0') + 'th') + '. Sample: ' + participationVolumeSpanText + '.' : 'Volume fallback is disabled in reported-historical-float-only mode.'
participationTooltip = 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2 (preserved 1D path)\nStatus: ' + participationDataStatus + '\n' + participationMethodText + '\nSetting: ' + participation_basis + '. Current actual float turnover: ' + (na(participationIntensity) ? '-' : str.tostring(participationIntensity, '0.00') + '%') + '. Window: ' + sameTimeWindowText + '.\nDisplayed sample: ' + str.tostring(participationSampleCount) + '/' + str.tostring(participation_len) + ' max (minimum ' + str.tostring(participationRequiredSamples) + '). Sample: ' + participationDisplayedSpanText + '.\n' + participationReportedAuditText + '\n' + participationVolumeAuditText + '\n' + historyDiagnostics + '\nReported float is annual and forward-filled, not a verified daily ownership record or publication-time history. No current-float backfill and no mixed float bases. The volume proxy uses the provider volume series and does not normalise historical changes in free float or shares outstanding. Current Float Turnover, RVOL, ADR and VWAP calculations are unchanged.'
adrPaceTooltip = 'Status: ' + adrDataStatus + '\nSigned open-to-current move / (ADR% * historical range-development fraction). Historical range-development factor: ' + adrProgressText + '. Window: ' + sameTimeWindowText + '.\nUsable sessions: ' + str.tostring(adrPaceSampleCount) + '/' + str.tostring(adr_pace_len) + ' max (minimum ' + str.tostring(adrRequiredSamples) + '). Sample: ' + adrSpanText + '.\n' + historyDiagnostics + '\nAt the close the factor is 100%, so this remains open-to-close % move / ADR%.'
// Expose the exact numerator and denominator used by the distance row. The source-volume
// ratio is diagnostic only: it is NOT a price multiplier or a reason to overwrite VWAP.
float vwapSourceVolumeRatio = rvatDailyVolume > 0 and not na(vwapNativeVolume) ? 100.0 * vwapNativeVolume / rvatDailyVolume : na
string vwapSourceMinuteText = not na(vwapNativeBarStart) and not na(vwapNativeBarEnd) ? str.format_time(vwapNativeBarStart, 'yyyy-MM-dd HH:mm', syminfo.timezone) + '-' + str.format_time(vwapNativeBarEnd, 'HH:mm', syminfo.timezone) : '-'
string vwapDataStatus = commonDataStatus != '' ? commonDataStatus : na(vwapNativeSession) ? 'One-minute source unavailable.' : vwapNativeSession != currentSessionStart ? 'Source belongs to another session; no substitute VWAP is published.' : not vwapNativeReady ? 'Initial/clipped source session or invalid source data; no substitute VWAP is published.' : na(vwapNativeVolume) or vwapNativeVolume <= 0 ? 'No usable one-minute volume in this session.' : na(sessionVWAP) ? 'One-minute VWAP or source timestamps failed validation.' : 'Native one-minute regular-session HLC3 VWAP; source-feed estimate.'
string vwapDistanceTooltip = 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2 (preserved 1D path)\nStatus: ' + vwapDataStatus + '\nPrice used: ' + (na(rvatDailyClose) ? '-' : str.tostring(rvatDailyClose, '0.0000')) + '. Session VWAP used: ' + (na(sessionVWAP) ? '-' : str.tostring(sessionVWAP, '0.0000')) + '. Distance = 100 * (price / VWAP - 1): ' + f_signedPct(distanceFromVWAP, '0.0000') + '.\nSource: ' + regularTicker + '; 1 minute; HLC3; reset each regular session. Latest source minute: ' + vwapSourceMinuteText + ' exchange time; native close: ' + (na(vwapNativeClose) ? '-' : str.tostring(vwapNativeClose, '0.0000')) + '.\nSource cumulative volume: ' + f_compactNumber(vwapNativeVolume) + '; daily-feed volume: ' + f_compactNumber(rvatDailyVolume) + '; source/daily ratio: ' + (na(vwapSourceVolumeRatio) ? '-' : str.tostring(vwapSourceVolumeRatio, '0.00') + '%') + '. Different feeds can cover different trades. No residual volume is priced at the current quote.\nCompare with a Session-anchored HLC3 VWAP on the same symbol, 1-minute calculation and regular-hours session. Developing prices/volume update when TradingView supplies new data; feed delays/revisions remain possible.'
string economicThroughputTooltip = 'Estimated regular-session notional = native 1-minute regular-session HLC3 VWAP * daily-feed volume. Economic Throughput = 100 * estimated notional / (current float * current price). This assumes the intraday average price represents daily-feed trades; it is not exact consolidated notional or net inflow. VWAP used: ' + (na(sessionVWAP) ? '-' : str.tostring(sessionVWAP, '0.0000')) + '. No residual volume is priced at the current quote.'
// Higher-period risk uses actual CHART-PERIOD returns, excluding the developing
// candle. It is not daily VaR multiplied by sqrt(days). The 1D path is untouched.
if barstate.islast and tfHigher
    array<float> hRiskReturns = array.new_float(0)
    int riskFirst = 1  // completed periods strictly PRIOR to the current chart period
    int riskLast = math.min(2 * var_len, bar_index - 1)
    if riskLast >= riskFirst
        for j = riskFirst to riskLast
            if array.size(hRiskReturns) >= var_len
                break
            float c1 = hPeriodClose[j]
            float c0 = hPeriodClose[j + 1]
            if not na(c1) and not na(c0) and c0 > 0 and c1 > 0
                float r = c1 / c0 - 1.0
                array.push(hRiskReturns, in_percent ? r * 100.0 : r)
    varMinimumSamples := hRiskFloor
    varSampleCount := array.size(hRiskReturns)
    varSampleReady := varSampleCount >= varMinimumSamples and percentile >= 0 and percentile <= 100
    VaR := na
    VaR5 := na
    ES5 := na
    std_dev_returns := na
    VaR_plus_3sigma := na
    if varSampleReady
        array.sort(hRiskReturns, order.ascending)
        VaR := array.percentile_linear_interpolation(hRiskReturns, percentile)
        VaR5 := array.percentile_linear_interpolation(hRiskReturns, 5.0)
        std_dev_returns := array.stdev(hRiskReturns, true)
        VaR_plus_3sigma := VaR - 3.0 * std_dev_returns
        int tailCount = math.max(1, int(math.ceil(varSampleCount * 0.05)))
        float tailTotal = 0.0
        for j = 0 to tailCount - 1
            tailTotal += array.get(hRiskReturns, j)
        ES5 := tailTotal / tailCount
    varSampleSuffix := varSampleReady and varSampleCount < var_len ? ' (n=' + str.tostring(varSampleCount) + ')' : ''
    varTooltip := 'Signed prior completed-' + periodTag + ' return quantile at ' + str.tostring(percentile) + '%, not a rescaled daily VaR. Current period excluded. n=' + str.tostring(varSampleCount) + ', minimum=' + str.tostring(varMinimumSamples) + '. Thin-tail estimates remain unstable.'
    var5Tooltip := 'Signed prior completed-' + periodTag + ' empirical 5% return quantile; n=' + str.tostring(varSampleCount) + '.'
    esTooltip := 'Average of worst ceil(5% × n) prior completed-' + periodTag + ' returns; n=' + str.tostring(varSampleCount) + '. Thin sample caveat applies.'
    tailQuality := 'Completed ' + periodTag + ' returns=' + str.tostring(varSampleCount) + '; 1% expected tail observations≈' + str.tostring(varSampleCount * 0.01, '0.0') + '.'
    stressTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nExtreme Stress = signed ' + periodTag + ' empirical return quantile - 3 * population standard deviation of the SAME completed-period sample. Current n=' + str.tostring(varSampleCount) + '; minimum=' + str.tostring(varMinimumSamples) + '. This is a descriptive severity overlay, not a conventional confidence level, Expected Shortfall or maximum possible loss.'

// Re-label the data actually used; never show a daily statistic under a weekly name.
if tfHigher
    string hDates = not na(hPeriodStart) ? str.format_time(hPeriodStart, 'yyyy-MM-dd HH:mm', syminfo.timezone) + ' to ' + (not na(hCutoff) ? str.format_time(hCutoff, 'yyyy-MM-dd HH:mm', syminfo.timezone) : '-') : '-'
    string hTradingPoint = hComplete ? 'completed ' + periodTag + ' candle; full-period versus full-period' : not na(hPosition) ? str.tostring(hPosition, '0.000') + ' trading sessions elapsed (session ordinal + proportional within-session time)' : 'current trading-session position unavailable'
    sameTimeWindowText := hDates + ' exchange time; ' + hTradingPoint
    completionText := not na(rvatHistoricalCompletion) ? str.tostring(100.0 * rvatHistoricalCompletion, '0.0') + '%' : '-'
    adrProgressText := not na(adrRangeProgressAvg) ? str.tostring(100.0 * adrRangeProgressAvg, '0.0') + '%' : '-'
    rvatLabel := 'Rel. Vol@Time (' + periodTag + (rvat_mode == 'Cumulative from open' ? ' cumul)' : ' ' + rvat_block + ' blk)')
    rvatDisplayText := rvatText + (not na(rvatValue) ? ' (n=' + str.tostring(rvatSampleCount) + ')' : '')
    adrPaceDisplayText := not na(adrPaceAtTime) ? f_signedNumber(adrPaceAtTime, '0.00', 'x ' + rangeTag) + ' (n=' + str.tostring(adrPaceSampleCount) + ')' : '-'
    participationRowLabel := (participationUsesVolumeProxy ? 'Volume Pctl (' : 'Part. Pctl (') + str.tostring(participation_len) + ' x ' + periodTag + ')' + (participationUsesVolumeProxy ? ' [proxy]' : ' [FY est.]')
    commonDataStatus := not hPeriodValid ? 'Native regular-hours chart-period data unavailable.' : not hUsable ? 'Current chart period has not started.' : not hComplete and not hCalendarMatches ? 'Daily calendar does not establish a complete current period/session index.' : ''
    rvatDataStatus := commonDataStatus != '' ? commonDataStatus : rvat_len < hAverageFloor ? 'Requested maximum is below the higher-TF minimum.' : not hPathCompatible ? 'Historical source is coarser than the selected block. Use Auto or finer sampling.' : na(rvatToday) ? 'Current matching block source is unavailable.' : rvatSampleCount < hAverageFloor ? 'Insufficient valid historical chart periods at this trading-session point.' : na(rvatAverage) or rvatAverage <= 0 ? 'Historical mean unavailable or zero; no finite RVOL ratio.' : rvatSampleCount < rvat_len ? 'Adaptive partial chart-period sample.' : 'Requested chart-period sample complete.'
    participationDataStatus := commonDataStatus != '' ? commonDataStatus : participation_len < hRankFloor ? 'Requested maximum is below the higher-TF percentile minimum.' : participationSampleCount < hRankFloor ? 'Insufficient valid same-time chart-period observations.' : participationUsesVolumeProxy ? 'Explicit same-time VOLUME proxy selected; no historical float is manufactured.' : 'Reported-FY-float chart-period turnover ranking.'
    adrDataStatus := commonDataStatus != '' ? commonDataStatus : adr_pace_len < hAverageFloor ? 'Requested maximum is below the higher-TF minimum.' : adrPaceSampleCount < hAverageFloor ? 'Too few valid range observations; an early partial source interval has no completed high/low yet.' : 'Average chart-period range, adjusted for historical range development by this point.'
    string hDiagnostics = 'Inspected ' + str.tostring(hScanned) + '/' + str.tostring(hScanLimit) + ' earlier chart bars. Invalid periods=' + str.tostring(hBadPeriod) + '; too few trading sessions=' + str.tostring(hTooShort) + '; no source history=' + str.tostring(hNoPath) + '; initial/clipped periods=' + str.tostring(hClipped) + '; invalid/inconsistent paths=' + str.tostring(hBadPath) + '; source/daily session-count mismatch=' + str.tostring(hBadDays) + '; missing FY float=' + str.tostring(hMissingFloat) + '; no completed range yet=' + str.tostring(hNoRange) + '.'
    string hMethod = 'Matching rule: same ordinal trading session and same fraction of that session. Weekends/closed days do not advance the clock. A holiday week can therefore compare its Wednesday (second session) with another week\'s Tuesday (second session). A short historical period that cannot reach the current ordinal is excluded; it is not padded. At the candle close all previous full periods are comparable.'
    string hSampling = 'Historical path: ' + hHistoryTf + '; maximum request 100,000 source bars. Partial VOLUME intervals are time-weighted; RANGE uses only completed intervals. Intraday/period feed volumes are reconciled proportionally; same-time history is an estimate. No normal market calendar or volume curve is hard-coded.'
    rvatSpanText := not na(rvatOldestStart) ? str.format_time(rvatOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(rvatNewestStart, 'yyyy-MM-dd', syminfo.timezone) + '; oldest ' + str.tostring(rvatOldestOffset) + ' chart bars back' : 'none'
    participationSpanText := not na(participationOldestStart) ? str.format_time(participationOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(participationNewestStart, 'yyyy-MM-dd', syminfo.timezone) : 'none'
    participationVolumeSpanText := not na(participationVolumeOldestStart) ? str.format_time(participationVolumeOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(participationVolumeNewestStart, 'yyyy-MM-dd', syminfo.timezone) : 'none'
    adrSpanText := not na(adrOldestStart) ? str.format_time(adrOldestStart, 'yyyy-MM-dd', syminfo.timezone) + ' to ' + str.format_time(adrNewestStart, 'yyyy-MM-dd', syminfo.timezone) : 'none'
    rvatTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nStatus: ' + rvatDataStatus + '\nChart: ' + periodTag + '; window: ' + sameTimeWindowText + '. Current selected-window volume=' + f_compactNumber(rvatToday) + '; historical same-time mean=' + f_compactNumber(rvatAverage) + '; matched full-period mean=' + f_compactNumber(rvatHistoricalFullDayAvg) + '; completion=' + completionText + '. Ratio=' + (not na(rvatRatio) ? str.tostring(rvatRatio, '0.0000') : '-') + '.\nSample n=' + str.tostring(rvatSampleCount) + '/' + str.tostring(rvat_len) + ' max; minimum=' + str.tostring(hAverageFloor) + '; dates=' + rvatSpanText + '.\n' + hMethod + '\n' + hSampling + '\n' + hDiagnostics
    participationTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nStatus: ' + participationDataStatus + '\nChart: ' + periodTag + '; window: ' + sameTimeWindowText + '. Turnover=' + f_signedPct(participationIntensity, '0.00') + '. Display n=' + str.tostring(participationSampleCount) + '/' + str.tostring(participation_len) + ' max; minimum=' + str.tostring(hRankFloor) + '.\nReported-FY-float sample=' + str.tostring(participationReportedCount) + ', percentile=' + (not na(participationReportedPctile) ? str.tostring(participationReportedPctile, '0.0') : '-') + '; dates=' + participationSpanText + '. Separate volume sample=' + str.tostring(participationVolumeCount) + ', percentile=' + (not na(participationVolumePctile) ? str.tostring(participationVolumePctile, '0.0') : '-') + '; dates=' + participationVolumeSpanText + '.\nFY float is the provider\'s snapshot mapped to each historical CHART PERIOD, not an exact within-period or publication-time float history. Current float is not backfilled. A [proxy] ranks volumes consistently for the entire sample; no mixture of denominators. Small sample percentiles have coarse resolution.\n' + hMethod + '\n' + hSampling + '\n' + hDiagnostics
    adrPaceTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nStatus: ' + adrDataStatus + '\nChart: ' + periodTag + '; window: ' + sameTimeWindowText + '. ' + rangeTag + '%=' + str.tostring(arp, '0.0000') + '; historical range-development factor=' + adrProgressText + '. Pace = signed chart-period open-to-current return / (' + rangeTag + '% * range-development factor). At the completed period close the factor is 1.0. This is not the candle high-low range divided by an average.\nSample n=' + str.tostring(adrPaceSampleCount) + '/' + str.tostring(adr_pace_len) + ' max; minimum=' + str.tostring(hAverageFloor) + '; dates=' + adrSpanText + '.\n' + hMethod + '\n' + hSampling + '\n' + hDiagnostics
    vwapDataStatus := na(hVwapKey) ? 'Native anchored source unavailable.' : hVwapKey != hPeriodStart ? 'Wrong-period anchor; no substitute is displayed.' : not hVwapReady ? 'Initial/clipped or invalid source anchor.' : na(sessionVWAP) ? 'Native source or timestamps failed validation.' : 'Native HLC3 VWAP anchored to the chart candle, using ' + hVwapTf + ' source bars.'
    vwapDistanceTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nStatus: ' + vwapDataStatus + '\nChart/anchor: ' + periodTag + '. Price=' + str.tostring(hPeriodClose, '0.0000') + '; period VWAP=' + (not na(sessionVWAP) ? str.tostring(sessionVWAP, '0.0000') : '-') + '; distance=100*(price/VWAP-1)=' + f_signedPct(distanceFromVWAP, '0.0000') + '.\nSource: regular hours, ' + hVwapTf + ', HLC3; reset at each ' + periodTag + ' boundary, NOT daily. Latest source bar=' + vwapSourceMinuteText + '. Source volume=' + f_compactNumber(hVwapVolume) + '; native period volume=' + f_compactNumber(hPeriodVolume) + '. No unmatched volume is priced at the latest quote.\nVWAP is a bar-source estimate, not transaction-level consolidated VWAP. Match symbol, source resolution, regular-hours session and anchor in any comparison. A manual resolution too fine to include the anchor remains unavailable rather than being silently changed.'
    economicThroughputTooltip := 'Chart period ' + periodTag + ': estimated notional = anchored native period VWAP * native period volume. Throughput = 100 * estimated notional / (current float * current price). Gross transactional throughput, not net inflow. This assumes the source VWAP is representative of all period-feed trades.'
    hProjectionTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nHigher-period seasonal SHARE projection, independent of cumulative/per-block display. Projected full-period volume = current period volume / historical cumulative completion. Current=' + f_compactNumber(hPeriodVolume) + '; completion=' + (not na(hShareCompletion) ? str.tostring(100.0 * hShareCompletion, '0.00') + '%' : '-') + '; projected=' + f_compactNumber(hProjectedVolume) + '; mean full-period volume=' + f_compactNumber(hShareAverage) + '. Buzz=100*(projected/mean-1).\nHistorical sample=' + str.tostring(hShareProjectionCount) + '/' + str.tostring(len) + ' max, minimum=' + str.tostring(hAverageFloor) + '. Current period excluded from historical average. At the period close projected equals realised volume. Conditional pace estimate, not a forecast guarantee.\n' + hMethod + '\n' + hSampling
    hDollarProjectionTooltip := 'Build: MULTIFRAME-INTRADAY-2026-10-13-v2\nHigher-period seasonal DOLLAR projection. Estimated period notional = source HLC3 VWAP * period volume; historical values use the same construction at the history-source resolution. Current estimate=' + f_compactNumber(hCurrentDollarVolume) + '; separate dollar completion=' + (not na(hDollarCompletion) ? str.tostring(100.0 * hDollarCompletion, '0.00') + '%' : '-') + '; projected=' + f_compactNumber(hProjectedDollarVolume) + '; mean full-period estimated notional=' + f_compactNumber(hDollarAverage) + '.\nHistorical sample=' + str.tostring(hDollarProjectionCount) + '/' + str.tostring(dollar_vol_len) + ' max, minimum=' + str.tostring(hAverageFloor) + '. Current period excluded. Estimate, not exact transaction-level dollar volume or a forecast guarantee.\n' + hSampling

// Below 1D, say plainly which data the table is showing.
if tfIntraday
    string iMirrorNote = 'Intraday chart (' + timeframe.period + '): showing the live 1D-chart reading; intraday candles are not used as observations.\n'
    rvatTooltip := iMirrorNote + rvatTooltip
    participationTooltip := iMirrorNote + participationTooltip
    adrPaceTooltip := iMirrorNote + adrPaceTooltip
    vwapDistanceTooltip := iMirrorNote + vwapDistanceTooltip
    economicThroughputTooltip := iMirrorNote + economicThroughputTooltip
    varTooltip := iMirrorNote + varTooltip
    var5Tooltip := iMirrorNote + var5Tooltip
    esTooltip := iMirrorNote + esTooltip
    stressTooltip := iMirrorNote + stressTooltip
// The main daily/intraday projection uses historic *fractions*, not linear time.
string dailyProjectionTooltip = 'Daily seasonal projections: current cumulative shares / average historical cumulative-volume fraction at the same session time; dollar projection uses a SEPARATE historical cumulative-notional fraction. Both require 21 valid historical sessions and at least ' + str.tostring(min_projection_minutes) + ' elapsed regular-session minutes. Share n=' + str.tostring(projectionShareN) + '/' + str.tostring(len) + ', dollar n=' + str.tostring(projectionDollarN) + '/' + str.tostring(dollar_vol_len) + '. Input feed: ' + rvat_intratf + ' minute regular-session HLC3/volume, matched to full-session totals. Missing/incomplete source history gives N/A, not a straight-line substitute. At the session close projection equals realised volume/notional. This is an estimate, not a trading-volume promise.'
// 2) Average Daily Vol
avgDaVol = request.security(s, tf, ma)
avgDaVolCalc = avgDaVol
uV = ''
if(avgDaVol >= 1000 and avgDaVol < 1000000)
    avgDaVol := avgDaVol/1000
    uV := 'K'
if(avgDaVol >= 1000000 and avgDaVol < 1000000000)
    avgDaVol := avgDaVol/1000000
    uV := 'M'
if(avgDaVol >= 1000000000)
    avgDaVol := avgDaVol/1000000000
    uV := 'B'
// 3) Average Daily $ Vol
// Below 1D, Market Cap fallback and Float % use the daily close, as on the 1D chart.
closeDa = request.security(s, tfIntraday ? 'D' : tf, close)
dolVol = vol * close // Dollar volume for current bar
dolVolMA = ta.sma(dolVol[1], dollar_vol_len) // Dollar volume MA with separate length parameter
advdolDa = request.security(s, tf, dolVolMA)
uVDoll = ''
if(advdolDa >= 1000 and advdolDa < 1000000)
    advdolDa := advdolDa/1000
    uVDoll := 'K'
if(advdolDa >= 1000000 and advdolDa < 1000000000)
    advdolDa := advdolDa/1000000
    uVDoll := 'M'
if(advdolDa >= 1000000000)
    advdolDa := advdolDa/1000000000
    uVDoll := 'B'
// Other parameters
// 4)  Market Cap
MCap = request.financial(s, 'MARKET_CAP_BASIC', 'D', ignore_invalid_symbol=true)
// Case where 'MARKET_CAP_BASIC' returns NaN
TSO = request.financial(s, 'TOTAL_SHARES_OUTSTANDING', 'FQ', ignore_invalid_symbol=true)
if na(MCap)
    MCap := TSO*closeDa
MCapCalc = MCap
uM = ''
if(MCap >= 1000 and MCap < 1000000)
    MCap := MCap/1000
    uM := 'K'
if(MCap >= 1000000 and MCap < 1000000000)
    MCap := MCap/1000000
    uM := 'M'
if(MCap >= 1000000000)
    MCap := MCap/1000000000
    uM := 'B'
// 5) Float%
// Float is resolved above for the participation calculations (live value with FY history fallback).
// Prefer same-basis LIVE share counts, rather than float-cap / unrelated reported cap.
// A mismatch is missing data, NOT a value to be force-capped to 100%.
float liveTotalShares = syminfo.shares_outstanding_total
float totalSharesBasis = not na(liveTotalShares) and liveTotalShares > 0 ? liveTotalShares : TSO
bool floatSharesConsistent = not na(totalSharesBasis) and totalSharesBasis > 0 and not na(FSO) and FSO >= 0 and FSO <= totalSharesBasis * 1.000001
float floatPer = floatSharesConsistent ? 100.0 * FSO / totalSharesBasis : na
float internallyConsistentCap = not na(totalSharesBasis) and totalSharesBasis > 0 and closeDa > 0 ? totalSharesBasis * closeDa : na
float reportedCapDifference = not na(internallyConsistentCap) and internallyConsistentCap > 0 and not na(MCapCalc) ? 100.0 * (MCapCalc / internallyConsistentCap - 1.0) : na
string floatBasisTooltip = 'Float% = currently available free-float shares / compatible total shares, not float market cap / a separately reported market cap. Current denominator: ' + (not na(liveTotalShares) and liveTotalShares > 0 ? 'live symbol total shares.' : 'FQ reported total shares fallback.') + ' If free float exceeds total, show N/A rather than a misleading 100%+ number. Financial FY float history is an approximation, not publication-time/PIT ownership data.'
string mCapTooltip = 'Reported market cap uses MARKET_CAP_BASIC where available, otherwise reported FQ shares × price. It may not match live share-count × price because source dates/currencies/share classes differ. Difference versus internally consistent total shares × price: ' + (na(reportedCapDifference) ? 'N/A' : f_signedPct(reportedCapDifference, '0.0')) + '. Treat large discrepancies as data-quality warnings.'
// 6) Projected session volume, using independent same-time historical profiles.
// No straight-line projection through overnight, lunch breaks or the opening burst.
// Full-period realised volume is returned after the regular session closes.
float volume_projected_unscaled = na
float dollar_volume_projected_unscaled = na
bool forecastClockReady = not na(rvatElapsedMinutes) and rvatElapsedMinutes >= min_projection_minutes
if tfOneDay
    volume_projected_unscaled := rvatSessionComplete ? rvatDailyVolume : forecastClockReady and not na(projectionShareCompletion) and projectionShareCompletion > 0 ? rvatDailyVolume / projectionShareCompletion : na
    dollar_volume_projected_unscaled := rvatSessionComplete ? sessionDollarVolume : forecastClockReady and not na(projectionDollarCompletion) and projectionDollarCompletion > 0 and not na(sessionDollarVolume) ? sessionDollarVolume / projectionDollarCompletion : na
// Higher chart periods have a separate native historical-completion engine below.
// Intraday charts mirror exactly the regular-session daily projection values.
float volume_projected = volume_projected_unscaled
float dollar_volume_projected = dollar_volume_projected_unscaled
string uP = ''
string uDP = ''
if not na(volume_projected)
    uP := math.abs(volume_projected) >= 1000000000 ? 'B' : math.abs(volume_projected) >= 1000000 ? 'M' : math.abs(volume_projected) >= 1000 ? 'K' : ''
    volume_projected /= uP == 'B' ? 1000000000.0 : uP == 'M' ? 1000000.0 : uP == 'K' ? 1000.0 : 1.0
if not na(dollar_volume_projected)
    uDP := math.abs(dollar_volume_projected) >= 1000000000 ? 'B' : math.abs(dollar_volume_projected) >= 1000000 ? 'M' : math.abs(dollar_volume_projected) >= 1000 ? 'K' : ''
    dollar_volume_projected /= uDP == 'B' ? 1000000000.0 : uDP == 'M' ? 1000000.0 : uDP == 'K' ? 1000.0 : 1.0
// 7) Volume Buzz based on projected volume
volBuzz = not na(ma) and ma > 0 and not na(volume_projected_unscaled) ? 100.0 * (volume_projected_unscaled / ma - 1.0) : na
// 7b) Dollar Volume Buzz based on projected dollar volume
dolVolBuzz = not na(dolVolMA) and dolVolMA > 0 and not na(dollar_volume_projected_unscaled) ? 100.0 * (dollar_volume_projected_unscaled / dolVolMA - 1.0) : na
// Higher periods use their separate native historical-completion projection.
// Daily and intraday charts use independently estimated seasonal completion fractions.
if tfHigher
    avgDaVolCalc := hShareAverage
    uV := not na(hShareAverage) and hShareAverage >= 1000000000 ? 'B' : not na(hShareAverage) and hShareAverage >= 1000000 ? 'M' : not na(hShareAverage) and hShareAverage >= 1000 ? 'K' : ''
    avgDaVol := hShareAverage / (uV == 'B' ? 1000000000.0 : uV == 'M' ? 1000000.0 : uV == 'K' ? 1000.0 : 1.0)
    uVDoll := not na(hDollarAverage) and hDollarAverage >= 1000000000 ? 'B' : not na(hDollarAverage) and hDollarAverage >= 1000000 ? 'M' : not na(hDollarAverage) and hDollarAverage >= 1000 ? 'K' : ''
    advdolDa := hDollarAverage / (uVDoll == 'B' ? 1000000000.0 : uVDoll == 'M' ? 1000000.0 : uVDoll == 'K' ? 1000.0 : 1.0)
    volume_projected_unscaled := hProjectedVolume
    dollar_volume_projected_unscaled := hProjectedDollarVolume
    uP := not na(hProjectedVolume) and hProjectedVolume >= 1000000000 ? 'B' : not na(hProjectedVolume) and hProjectedVolume >= 1000000 ? 'M' : not na(hProjectedVolume) and hProjectedVolume >= 1000 ? 'K' : ''
    volume_projected := hProjectedVolume / (uP == 'B' ? 1000000000.0 : uP == 'M' ? 1000000.0 : uP == 'K' ? 1000.0 : 1.0)
    uDP := not na(hProjectedDollarVolume) and hProjectedDollarVolume >= 1000000000 ? 'B' : not na(hProjectedDollarVolume) and hProjectedDollarVolume >= 1000000 ? 'M' : not na(hProjectedDollarVolume) and hProjectedDollarVolume >= 1000 ? 'K' : ''
    dollar_volume_projected := hProjectedDollarVolume / (uDP == 'B' ? 1000000000.0 : uDP == 'M' ? 1000000.0 : uDP == 'K' ? 1000.0 : 1.0)
    volBuzz := not na(hShareAverage) and hShareAverage > 0 and not na(hProjectedVolume) ? 100.0 * (hProjectedVolume / hShareAverage - 1.0) : na
    dolVolBuzz := not na(hDollarAverage) and hDollarAverage > 0 and not na(hProjectedDollarVolume) ? 100.0 * (hProjectedDollarVolume / hDollarAverage - 1.0) : na
    relVol := not na(hShareAverage) and hShareAverage > 0 ? 100.0 * hPeriodVolume / hShareAverage : na
// Below 1D, the volume rows use the 1D chart's daily bar and daily averages. The 1D linear
// projection equations above are kept exactly; only their inputs come from the daily bar.
if tfIntraday
    // Daily mirror: same daily same-time seasonal numerator and completion profile.
    // No chart-clock extrapolation (an hourly bar is not an independent daily session).
    float iVolumeProjected = rvatSessionComplete ? iDayVolume : forecastClockReady and not na(projectionShareCompletion) and projectionShareCompletion > 0 ? iDayVolume / projectionShareCompletion : na
    float iDollarProjected = rvatSessionComplete ? sessionDollarVolume : forecastClockReady and not na(projectionDollarCompletion) and projectionDollarCompletion > 0 and not na(sessionDollarVolume) ? sessionDollarVolume / projectionDollarCompletion : na
    relVol := not na(iDayVolumeMA) and iDayVolumeMA > 0 ? 100.0 * iDayVolume / iDayVolumeMA : na
    volBuzz := not na(iDayVolumeMA) and iDayVolumeMA > 0 and not na(iVolumeProjected) ? 100.0 * (iVolumeProjected / iDayVolumeMA - 1) : na
    dolVolBuzz := not na(iDayDollarVolumeMA) and iDayDollarVolumeMA > 0 and not na(iDollarProjected) ? 100.0 * (iDollarProjected / iDayDollarVolumeMA - 1) : na
    volume_projected_unscaled := iVolumeProjected
    dollar_volume_projected_unscaled := iDollarProjected
    avgDaVolCalc := iDayVolumeMA
    uV := not na(iDayVolumeMA) and iDayVolumeMA >= 1000000000 ? 'B' : not na(iDayVolumeMA) and iDayVolumeMA >= 1000000 ? 'M' : not na(iDayVolumeMA) and iDayVolumeMA >= 1000 ? 'K' : ''
    avgDaVol := iDayVolumeMA / (uV == 'B' ? 1000000000.0 : uV == 'M' ? 1000000.0 : uV == 'K' ? 1000.0 : 1.0)
    uVDoll := not na(iDayDollarVolumeMA) and iDayDollarVolumeMA >= 1000000000 ? 'B' : not na(iDayDollarVolumeMA) and iDayDollarVolumeMA >= 1000 ? 'K' : ''
    uVDoll := not na(iDayDollarVolumeMA) and iDayDollarVolumeMA >= 1000000 ? 'M' : uVDoll
    advdolDa := iDayDollarVolumeMA / (uVDoll == 'B' ? 1000000000.0 : uVDoll == 'M' ? 1000000.0 : uVDoll == 'K' ? 1000.0 : 1.0)
    uP := not na(iVolumeProjected) and iVolumeProjected >= 1000000000 ? 'B' : not na(iVolumeProjected) and iVolumeProjected >= 1000000 ? 'M' : not na(iVolumeProjected) and iVolumeProjected >= 1000 ? 'K' : ''
    volume_projected := iVolumeProjected / (uP == 'B' ? 1000000000.0 : uP == 'M' ? 1000000.0 : uP == 'K' ? 1000.0 : 1.0)
    uDP := not na(iDollarProjected) and iDollarProjected >= 1000000000 ? 'B' : not na(iDollarProjected) and iDollarProjected >= 1000000 ? 'M' : not na(iDollarProjected) and iDollarProjected >= 1000 ? 'K' : ''
    dollar_volume_projected := iDollarProjected / (uDP == 'B' ? 1000000000.0 : uDP == 'M' ? 1000000.0 : uDP == 'K' ? 1000.0 : 1.0)

// 8) Sector
string sector = syminfo.sector
if(na(sector))
    sector := 'N/A'
// 9) Industry group
string industryGrp = syminfo.industry
if(na(industryGrp))
    industryGrp := 'N/A'
// 10) Derived RS Ratio vs SPX and optional externally calibrated 1-99 score.
// Without seven valid, strictly descending seed calibration thresholds, show N/A.
int n63 = math.min(bar_index, 63)
int n126 = math.min(bar_index, 126)
int n189 = math.min(bar_index, 189)
int n252 = math.min(bar_index, 252)
closeDa := request.security(syminfo.tickerid, tfHigher ? timeframe.period : 'D', close)
float spxCloseDa = request.security('SP:SPX', tfHigher ? timeframe.period : 'D', close)
float perfStock = 0.4 * (closeDa / closeDa[n63]) + 0.2 * (closeDa / closeDa[n126]) + 0.2 * (closeDa / closeDa[n189]) + 0.2 * (closeDa / closeDa[n252])
float perfIndex = 0.4 * (spxCloseDa / spxCloseDa[n63]) + 0.2 * (spxCloseDa / spxCloseDa[n126]) + 0.2 * (spxCloseDa / spxCloseDa[n189]) + 0.2 * (spxCloseDa / spxCloseDa[n252])
float totalRsScore = not na(perfIndex) and perfIndex > 0 ? 100.0 * perfStock / perfIndex : na
float curveRsPerf = request.seed('seed_fred6725_rs_rating', 'RSRATING', close)
float totalRsRating = f_rsCalibrated(totalRsScore, curveRsPerf)
if tfIntraday
    // Carry exact daily metrics onto lower timeframes; no intraday horizons.
    totalRsScore := iRsScore
    totalRsRating := iRsRating
string rsRatingTooltip = tfHigher ? 'Weighted relative-strength RATIO versus SPX on chart-period horizons. 100 = parity; this is NOT a 1–99 percentile. A weekly 63-bar input means 63 weeks.' : 'Approximate 1–99 RS rank, calculated from weighted 63/126/189/252-day performance versus SPX and an external request.seed calibration. Requires seven positive STRICTLY descending thresholds; otherwise N/A. Neither a complete-universe ranking nor an official IBD RS Rating. Source data availability can change.'
// 11) Liquidity Cap (Based on 1% of MA Volume Length)
volDa        = request.security(s, 'D', volume)
// Liquidity cap is DAILY, including on weekly/monthly charts; use only
// completed regular-session daily volumes in the reference average.
float dailyADV = request.security(regularTicker, 'D', ta.sma(volume[1], len), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
liquidityCap = not na(dailyADV) ? dailyADV * 0.01 : na
float daysToLiquidate = position_shares > 0 and not na(dailyADV) and dailyADV > 0 ? position_shares / (dailyADV * max_adv_participation_pct / 100.0) : na
// 12) Up/Down Volume Ratio
upVol =         close > close[1] ? volume : 0
dnVol =         close < close[1] ? volume : 0
sumUp =         math.sum(upVol, 50)
sumDn =         math.sum(dnVol, 50)
upDnVolRatio = sumDn > 0 ? sumUp / sumDn : na
if tfIntraday
    upDnVolRatio := iUpDnVolRatio
// 13) Distance% From 52 Week High/Low
fiftyTwoWeekHigh = request.security(syminfo.tickerid, 'W', ta.highest(high,52)) // 52-week high
fiftyTwoWeekLow  = request.security(syminfo.tickerid, 'W', ta.lowest(low,52))   // 52-week low
distFromHigh = 100 * (closeDa/fiftyTwoWeekHigh-1)
distFromLow  = 100 * (closeDa/fiftyTwoWeekLow-1)
// 14) Shares Float
// UPDATED: use the same resolved float (live -> FY fallback) for display
sharesFloat = FSO
uF = ''
if(sharesFloat >= 1000 and sharesFloat < 1000000)
    sharesFloat := sharesFloat/1000
    uF := 'K'
if(sharesFloat >= 1000000 and sharesFloat < 1000000000)
    sharesFloat := sharesFloat/1000000
    uF := 'M'
if(sharesFloat >= 1000000000)
    sharesFloat := sharesFloat/1000000000
    uF := 'B'
// Define colours based on conditions
dolVolBuzzColor = dolVolBuzz > 100 ? color.green : txt_col
volBuzzColor = volBuzz > 100 ? color.green : txt_col
relVolColor = relVolExceeded50InFirst30Min ? color.yellow : txt_col
adrpColor = arp > 5 ? color.green : txt_col
rvatColor = not na(rvatRatio) and rvatRatio > 1.0 ? color.green : txt_col
participationPctileColor = na(participationPctile) ? txt_col : participationPctile >= 90 ? color.green : participationPctile <= 10 ? color.red : txt_col
dayRangeColor = na(dayRangePosition) ? txt_col : dayRangePosition >= 80 ? color.green : dayRangePosition <= 20 ? color.red : txt_col
vwapDistanceColor = na(distanceFromVWAP) ? txt_col : distanceFromVWAP >= 0 ? color.green : color.red
priceImpactColor = na(priceImpactPerTurnover) ? txt_col : priceImpactPerTurnover >= 0 ? color.green : color.red
adrPaceColor = na(adrPaceAtTime) ? txt_col : adrPaceAtTime > 0 ? color.green : adrPaceAtTime < 0 ? color.red : txt_col
// ── Unified table renderer ──────────────────────────────────────────────────
// All 9 anchors, 5 font sizes, Custom-by-default row controls and fixed presets.
// Row visibility is presentation-only. The calculation engines remain active.
// Restore the supported-timeframe flag used by the table rows.
bool tfDaily = tfPeriodSupported or tfIntraday
f_rowEnabled(bool enabled, bool inCompact) =>
    tablePreset == 'Full Research' ? true : tablePreset == 'Compact' ? inCompact : enabled

f_tableRow(table board, int row, string metric, string reading, color metricColour, string description) =>
    table.cell(board, 0, row, metric, text_color=metricColour, text_size=size_tbl, text_halign=align_txt_left, tooltip=description)
    table.cell(board, 1, row, reading, text_color=metricColour, text_size=size_tbl, text_halign=align_txt_right, tooltip=description)

// Compact deliberately resembles the trader's original screenshot.
// Custom uses the individual Display toggles; Full Research shows every row.
var table t = table.new(tablePos, 2, 44, bgcolor=bg_col)
if barstate.islast
    table.clear(t, 0, 0, 1, 43)
    int tableRow = 0
    if show_empty_row
        table.cell(t, 0, tableRow, ' ', text_color=txt_col, text_size=size_tbl)
        tableRow += 1
    string standardRiskSuffix = in_percent ? '%' : ''
    string todayRangeStatus = na(dayRangePosition) ? '-' : str.tostring(dayRangePosition, '0') + '%'
    string projectedShareDisplay = tfHigher ? f_compactNumber(hProjectedVolume) : f_compactNumber(volume_projected_unscaled)
    string projectedNotionalDisplay = tfHigher ? f_compactNumber(hProjectedDollarVolume) : f_compactNumber(dollar_volume_projected_unscaled)
    string projectionInfo = tfHigher ? hProjectionTooltip : dailyProjectionTooltip
    string dollarProjectionInfo = tfHigher ? hDollarProjectionTooltip : dailyProjectionTooltip
    string rsValue = tfHigher ? (na(totalRsScore) ? '-' : str.tostring(totalRsScore, '0.0') + ' [ratio]') : na(totalRsRating) ? 'N/A' : str.tostring(totalRsRating, '0.0') + ' [est.]'
    string currentDataQuality = (floatSharesConsistent ? 'Float OK; ' : 'FLOAT MISMATCH; ') + 'VaR: ' + str.tostring(varSampleCount) + '/' + str.tostring(var_len) + '; RV@Time: ' + str.tostring(rvatSampleCount) + '/' + str.tostring(rvat_len) + '; participation: ' + str.tostring(participationSampleCount) + '/' + str.tostring(participation_len) + (participationUsesVolumeProxy ? ' [V-proxy]' : ' [FY est.]')
    string dataQualityTooltip = tailQuality + '\n' + participationTooltip + '\n' + rvatTooltip
    string efficiencyTooltip = 'Signed candle body / range = 100*(period close-period open)/(period high-period low). -100 to +100%. +60% means an upward net body equal to 60% of the range; it is NOT a 60% price gain or a path-smoothness score. Zero means close=open, even after large swings. Does not establish institutional accumulation. Zero high-low range is unavailable.'
    string projectedSharesValue = na(volume_projected_unscaled) ? '-' : projectedShareDisplay
    string projectedDollarsValue = na(dollar_volume_projected_unscaled) ? '-' : '$' + projectedNotionalDisplay
    string marketCapValue = f_compactNumber(MCapCalc)
    string floatCountValue = f_compactNumber(FSO)
    string avgShareValue = tfHigher ? f_compactNumber(hShareAverage) : f_compactNumber(avgDaVolCalc)
    string avgDollarValue = tfHigher ? f_compactNumber(hDollarAverage) : tfIntraday ? f_compactNumber(iDayDollarVolumeMA) : f_compactNumber(dolVolMA)
    if f_rowEnabled(show_mktCap, true)
        f_tableRow(t, tableRow, 'Market Cap', marketCapValue, txt_col, mCapTooltip)
        tableRow += 1
    if f_rowEnabled(show_float, true)
        f_tableRow(t, tableRow, 'Shares Float', floatCountValue, txt_col, floatBasisTooltip)
        tableRow += 1
    if f_rowEnabled(show_floatpercent, true)
        f_tableRow(t, tableRow, 'Float %', na(floatPer) ? 'N/A [mismatch]' : str.tostring(floatPer, '0.0') + '%', na(floatPer) ? color.red : txt_col, floatBasisTooltip)
        tableRow += 1
    if f_rowEnabled(show_float_turnover, true)
        f_tableRow(t, tableRow, tfHigher ? periodName + ' Float Turnover' : 'Float Turnover', tfDaily ? f_signedPct(participationIntensity,'0.00') : '-', txt_col, 'Regular-session traded share volume / current available free-float shares. Gross activity, NOT the percentage of unique ownership transferred.')
        tableRow += 1
    if f_rowEnabled(show_participation_pctile, true)
        f_tableRow(t, tableRow, participationRowLabel, tfDaily and not na(participationPctile) ? str.tostring(participationPctile,'0.0') + 'th (n=' + str.tostring(participationSampleCount) + ')' : '-', participationPctileColor, participationTooltip)
        tableRow += 1
    if f_rowEnabled(show_adrp, true)
        f_tableRow(t, tableRow, rangeTag + '%', na(arp) ? '-' : str.tostring(arp, '0.00') + '%', adrpColor, 'Average range %; selected denominator = ' + adrp_basis + '. This differs from Wilder ATR% and may use a different period length.')
        tableRow += 1
    if f_rowEnabled(show_adr_comparable, false)
        f_tableRow(t, tableRow, 'Range% / prev close', na(arpComparable) ? '-' : str.tostring(arpComparable, '0.00') + '%', txt_col, 'Comparison-friendly price range %: average of 100 × (high-low) / prior close across the selected range window.')
        tableRow += 1
    if f_rowEnabled(show_adr_pace, false)
        f_tableRow(t, tableRow, rangeTag + ' Pace @Time', adrPaceDisplayText, adrPaceColor, adrPaceTooltip)
        tableRow += 1
    if f_rowEnabled(show_atrPer, true)
        f_tableRow(t, tableRow, 'ATR%', na(atrp) ? '-' : str.tostring(atrp, '0.00') + '%', txt_col, 'Wilder ATR divided by current close; includes gaps and uses the ATR lookback length.')
        tableRow += 1
    if f_rowEnabled(show_var, true)
        f_tableRow(t, tableRow, 'VaR ' + str.tostring(percentile) + '%' + (tfHigher ? ' (' + periodTag + ')' : ''), na(VaR) ? '-' : str.tostring(VaR,'0.00') + standardRiskSuffix + varSampleSuffix, txt_col, varTooltip)
        tableRow += 1
    if f_rowEnabled(show_var5, false)
        f_tableRow(t, tableRow, 'VaR 5% (prior returns)', na(VaR5) ? '-' : str.tostring(VaR5,'0.00') + standardRiskSuffix, txt_col, var5Tooltip)
        tableRow += 1
    if f_rowEnabled(show_es5, true)
        f_tableRow(t, tableRow, 'Expected Shortfall 5%', na(ES5) ? '-' : str.tostring(ES5,'0.00') + standardRiskSuffix, txt_col, esTooltip)
        tableRow += 1
    if f_rowEnabled(show_var_plus_3sigma, false)
        f_tableRow(t, tableRow, 'Legacy stress: VaR − 3σ', na(VaR_plus_3sigma) ? '-' : str.tostring(VaR_plus_3sigma,'0.00') + standardRiskSuffix, txt_col, stressTooltip)
        tableRow += 1
    if f_rowEnabled(show_atr, false)
        f_tableRow(t, tableRow, 'ATR (price units)', na(atr) ? '-' : str.tostring(atr, '0.00'), txt_col, 'Wilder ATR in the quote currency, not a percentage.')
        tableRow += 1
    if f_rowEnabled(show_ipo_date, false)
        f_tableRow(t, tableRow, 'Available daily history (~yr)', str.tostring(ipoSince, '0.00'), txt_col, 'Approximately daily bars on provider chart / 252. NOT verified IPO age, may reflect truncated historical data.')
        tableRow += 1
    if f_rowEnabled(show_lod_dist, false)
        f_tableRow(t, tableRow, tfHigher ? periodName + ' Low (ATR units)' : 'Above LoD (ATR units)', na(lod_dist) ? '-' : str.tostring(lod_dist/100.0,'0.00')+'x ATR', txt_col, 'Distance above current period low divided by ATR, NOT percent of price.')
        tableRow += 1
    if f_rowEnabled(show_lod_price, false)
        f_tableRow(t, tableRow, tfHigher ? periodName + ' Low Price' : 'LoD Price', str.tostring(lod_price, '0.00'), txt_col, 'Lowest price within this period.')
        tableRow += 1
    if f_rowEnabled(show_dist_high, false)
        f_tableRow(t, tableRow, 'Off 52W High', na(distFromHigh) ? '-' : f_signedPct(distFromHigh,'0.0'), txt_col, 'Closing price versus high of last 52 calendar trading weeks.')
        tableRow += 1
    if f_rowEnabled(show_dist_low, false)
        f_tableRow(t, tableRow, 'Above 52W Low', na(distFromLow) ? '-' : f_signedPct(distFromLow,'0.0'), txt_col, 'Closing price versus low of last 52 trading weeks.')
        tableRow += 1
    if f_rowEnabled(show_ADVS, false)
        f_tableRow(t, tableRow, tfHigher ? 'Avg ' + periodTag + ' $ Vol' : 'Avg $ Vol', avgDollarValue == '-' ? '-' : '$' + avgDollarValue, txt_col, dollarProjectionInfo)
        tableRow += 1
    if f_rowEnabled(show_proj_dollar_vol, false)
        f_tableRow(t, tableRow, tfHigher ? 'Proj. ' + periodTag + ' $ Vol' : 'Projected $ Vol', projectedDollarsValue, txt_col, dollarProjectionInfo)
        tableRow += 1
    if f_rowEnabled(show_dolVolBuzz, false)
        f_tableRow(t, tableRow, '$ Vol. Buzz', f_signedPct(dolVolBuzz,'0'), dolVolBuzzColor, dollarProjectionInfo)
        tableRow += 1
    if f_rowEnabled(show_ADV, false)
        f_tableRow(t, tableRow, tfHigher ? 'Avg ' + periodTag + ' Vol' : 'Avg Vol', avgShareValue, txt_col, projectionInfo)
        tableRow += 1
    if f_rowEnabled(show_projectedVol, false)
        f_tableRow(t, tableRow, tfHigher ? 'Proj. ' + periodTag + ' Vol' : 'Projected Volume', projectedSharesValue, txt_col, projectionInfo)
        tableRow += 1
    if f_rowEnabled(show_volBuzz, false)
        f_tableRow(t, tableRow, 'Volume Buzz', f_signedPct(volBuzz,'0'), volBuzzColor, projectionInfo)
        tableRow += 1
    if f_rowEnabled(show_relVol, false)
        f_tableRow(t, tableRow, 'Relative Volume', na(relVol) ? '-' : str.tostring(relVol,'0') + '%', relVolColor, 'Current period volume / mean of prior ' + str.tostring(len) + ' completed period volumes. 150% means 50% above the historical average. Does not adjust for time elapsed.')
        tableRow += 1
    if f_rowEnabled(show_rvat, true)
        f_tableRow(t, tableRow, rvatLabel, tfDaily ? rvatDisplayText : '-', rvatColor, rvatTooltip)
        tableRow += 1
    if f_rowEnabled(show_economic_throughput, false)
        f_tableRow(t, tableRow, 'Economic Throughput [est.]', tfDaily ? f_signedPct(economicThroughput,'0.00') : '-', txt_col, economicThroughputTooltip)
        tableRow += 1
    if f_rowEnabled(show_day_range_position, true)
        f_tableRow(t, tableRow, periodName + ' Range Position', tfDaily ? todayRangeStatus : '-', dayRangeColor, 'Location within current period range: 0% low, 50% midpoint, 100% high. Not an order-flow proxy.')
        tableRow += 1
    if f_rowEnabled(show_directional_efficiency, true)
        f_tableRow(t, tableRow, 'Directional Efficiency', tfDaily ? f_signedPct(directionalEfficiency,'0') : '-', na(directionalEfficiency) ? txt_col : directionalEfficiency >= 0 ? color.green : color.red, efficiencyTooltip)
        tableRow += 1
    if f_rowEnabled(show_vwap_distance, true)
        f_tableRow(t, tableRow, tfHigher ? 'Distance from ' + periodTag + ' VWAP' : 'Distance from VWAP', tfDaily ? f_signedPct(distanceFromVWAP,'0.00') : '-', vwapDistanceColor, vwapDistanceTooltip)
        tableRow += 1
    if f_rowEnabled(show_price_impact, false)
        f_tableRow(t, tableRow, 'Price Response / 1% Float', tfDaily ? f_signedNumber(priceImpactPerTurnover,'0.00',' pp') : '-', priceImpactColor, 'Selected price return (%) / gross float turnover (%). +2% return with 0.5% turnover gives +4.00 pp of price return per 1% turnover. The association is NOT measured market impact, proof of accumulation or a causal attribution. Small turnover can inflate the ratio. Select the price-return basis in Participation / Acceptance.')
        tableRow += 1
    if f_rowEnabled(show_UDratio, false)
        f_tableRow(t, tableRow, 'Up/Down Candle Volume', na(upDnVolRatio) ? '-' : str.tostring(upDnVolRatio,'0.00')+'x', txt_col, '50-period up-close-candle volume divided by down-close-candle volume. NOT aggressor buyer/seller trade volume. Unavailable when denominator is zero.')
        tableRow += 1
    if f_rowEnabled(show_rs_rating, false)
        f_tableRow(t, tableRow, tfHigher ? 'RS vs SPX ('+periodTag+')' : 'RS percentile [est.]', rsValue, txt_col, rsRatingTooltip)
        tableRow += 1
    if f_rowEnabled(show_liqCap, false)
        f_tableRow(t, tableRow, '1% Daily ADV (shares)', f_compactNumber(liquidityCap), txt_col, 'Reference: 1% of prior completed daily shares traded, computed from a daily session even on a higher-timeframe chart. Not a regulatory or exchange liquidity cap.')
        tableRow += 1
    if f_rowEnabled(show_days_liquidate, false)
        f_tableRow(t, tableRow, 'Days to Liquidate [est.]', position_shares <= 0 ? 'Enter position shares' : na(daysToLiquidate) ? 'Awaiting daily ADV' : str.tostring(daysToLiquidate,'0.0') + ' d', txt_col, 'Set Optional portfolio position (shares) and Maximum share of daily ADV (%) under Parameters. Estimate = shares / (daily ADV * participation / 100), in full-session-equivalent trading days. No allowance for market impact, changing volume, weekends, halts or execution constraints. A dash elsewhere means unavailable data; this row identifies its missing input.')
        tableRow += 1
    if f_rowEnabled(show_data_quality, false)
        f_tableRow(t, tableRow, 'Source / Samples', currentDataQuality, txt_col, dataQualityTooltip)
        tableRow += 1
    if f_rowEnabled(show_sector, true)
        f_tableRow(t, tableRow, 'Sector', sector, txt_col, 'TradingView-reported sector label for this symbol.')
        tableRow += 1
    if f_rowEnabled(show_ind, true)
        f_tableRow(t, tableRow, 'Industry Group', industryGrp, txt_col, 'TradingView-reported industry label for this symbol.')
        tableRow += 1

        float volumeBeforeBlock = currentBlockStart == currentSessionStart ? 0.0 : currentDataStatus == 0 ? nz(f_windowSum(rvatIntraVols, rvatIntraStarts, rvatIntraEnds, currentSessionStart, currentBlockStart), 0.0) : na

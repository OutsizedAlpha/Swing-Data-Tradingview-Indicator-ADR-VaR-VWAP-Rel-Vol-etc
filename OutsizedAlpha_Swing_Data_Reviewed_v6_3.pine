indicator(title='OutsizedAlpha Swing Data — Audited', shorttitle='OA Swing Data', overlay=true, max_bars_back=3500, dynamic_requests=true)
// Build: OUTSIZEDALPHA-SWING-DATA-v3.3 — table-control and help-text repair.
// Custom is the default; individual row inputs are enabled only in Custom.
// All v3.2 calculation-engine, scope and indentation fixes are retained unchanged.
// Based on jfsrev's original Swing Data indicator and further OutsizedAlpha
// modifications. Projected Volume credits Bob-Lablaw in the source history.
// Public reuse must preserve applicable upstream attribution and licensing.
//
// DAILY (<1D charts mirror the requested 1D series):
// - completed-return-only historical VaR/ES, adjustable empirical 1% and 5% tails;
// - correct float% share-count denominator with explicit mismatch status;
// - independent same-time seasonal share and notional projections, no linear clock;
// - separate FY-float estimate versus consistent volume proxy; sample counts;
// - seven-ordered-level RS calibration guard, otherwise N/A.
//
// 2D+, W, M: period-native risk, participation and projections remain separate.
// No current-period return enters the risk reference. Requested lookbacks are
// targets, with 3,000-history-scan and TradingView source-bar resource limits.
// Intraday histories are validated against source cumulative data where possible.
// Current VWAP remains EXACTLY a percent price/VWAP deviation, never ADR/ATR.
// A given daily 21/63-floor still applies to its respective metrics; 126 prior
// completed daily returns minimum for VaR. FY shares aren't PIT ownership data.
// Native TradingView compilation/live feed behaviour still needs user testing.
// Select Custom to control each metric with its tick box. Compact and Full Research
// are fixed presets: their row tick boxes are deliberately disabled, not ignored silently.
tablePreset = input.string('Custom', title='Table Preset', options=['Custom','Compact','Full Research'], group='Table', tooltip='Custom (default): every Display tick box directly controls its own row. Compact: fixed 15-row view. Full Research: all 39 metric rows. The Display tick boxes are disabled in the two fixed presets; switch back to Custom to edit your selection. Previously saved Custom selections are not changed by using a preset.')
bool customRowControls = tablePreset == 'Custom'
show_empty_row    = input(true, title='Add an empty row above the displayed values', tooltip='Serves the purpose of not having the pane icons overlap with the ' +'text in the table if multiple panes are shown and the chart pane is hovered')
show_mktCap = input.bool(true, title='Show Market Cap', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_float = input.bool(true, title='Show Shares Float', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_floatpercent = input.bool(true, title='Show Float%', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_float_turnover = input.bool(true, title='Show Float Turnover', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_participation_pctile = input.bool(true, title='Show Participation Intensity Percentile', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_adrp = input.bool(true, title='Show ADR%', group='Display', active=customRowControls, tooltip='Average percentage high-low range using ADR% Length and the selected ADR% denominator. Low (legacy) uses each candle low; Previous close (comparable) uses its previous close. Daily on charts below 1D, otherwise chart-period range.')
show_adr_comparable = input.bool(false, title='Show comparable range% / previous close', group='Display', active=customRowControls, tooltip='Average of 100*(high-low)/previous close across ADR% Length candles. This is an alternative normalisation of the high-low range, not a price-return signal. If ADR% denominator is already Previous close (comparable), this row duplicates ADR%.')
show_adr_pace = input.bool(true, title='Show ADR Pace @Time', group='Display', active=customRowControls, tooltip='Signed open-to-current percentage move divided by ADR% times the historical fraction of range normally developed by this session point. At the close that fraction is 1. A reading near zero can occur despite a large high-low range if price returns to its open.')
show_atrPer = input.bool(false, title='Show ATR%', group='Display', active=customRowControls, tooltip='Wilder average true range divided by current price, multiplied by 100. True range includes gaps from the preceding close. This can use a different lookback and averaging method from ADR%; it is not their difference or a confidence bound.')
show_var = input.bool(true, title="Show VaR (Value at Risk)", group='Display', active=customRowControls, tooltip='Historical lower-tail return quantile at Selected VaR lower-tail percentile, using completed returns before the current period. Default tail is 1%. A reading of -5% is an estimated historical return cutoff, NOT the maximum possible loss or a guarantee about the next session. No Sharpe ratio is calculated.')
show_var_plus_3sigma = input.bool(false, title='Show legacy stress heuristic (VaR - 3σ)', group='Display', active=customRowControls, tooltip='Optional bespoke stress heuristic: selected historical VaR minus three population standard deviations of the same return sample. This has no separate calibrated confidence level and is not Expected Shortfall.')
show_var5 = input.bool(true, title='Show 5% Historical VaR', group='Display', active=customRowControls, tooltip='Separate 5th-percentile signed return cutoff using prior completed returns. Example: -3% describes the approximate boundary of the worst 5% of that historical sample, not a 5% loss amount. It duplicates the selected VaR row when Selected VaR lower-tail percentile is 5.')
show_es5 = input.bool(true, title='Show 5% Expected Shortfall', group='Display', active=customRowControls, tooltip='Historical average of the worst ceil(0.05*n) prior completed returns. At n=252, average the worst 13 returns. This estimates observed tail severity, rather than the cutoff shown by 5% VaR. The rounded tail count and small sample introduce uncertainty. Daily minimum is 126 prior completed returns.')
show_atr = input.bool(false, title='Show ATR', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_ipo_date = input.bool(false, title='Show IPO Timer', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_lod_dist = input.bool(true, title='Show LoD dist.', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_lod_price = input.bool(true, title='Show LoD Price', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_dist_high = input.bool(true, title='Show %dist of 52 We High', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_dist_low = input.bool(true, title='Show %dist of 52 We Low', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_ADVS = input.bool(true, title='Show Avg $ Volume', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_ADV = input.bool(true, title='Show Avg Volume', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_projectedVol = input.bool(true, title='Show Projected Volumes', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_proj_dollar_vol = input.bool(true, title='Show Projected $ Volume', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_relVol = input.bool(true, title='Show Relative Volume', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_rvat = input.bool(true, title='Show Rel. Vol at Time', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_economic_throughput = input.bool(true, title='Show Economic Throughput', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_day_range_position = input.bool(true, title='Show Day Range Position', group='Display', active=customRowControls, tooltip='Current price position within the regular-session period high-low range: 0% at the low, 50% at the midpoint, 100% at the high. Unlike Directional Efficiency, this does not measure the move from the open.')
show_vwap_distance = input.bool(true, title='Show Distance from VWAP', group='Display', active=customRowControls, tooltip='Percentage distance from the native regular-session VWAP: 100*(price/VWAP-1). Positive is above VWAP; negative is below. Remains a percentage only, with no ADR/ATR normalisation. The snapshot does not measure how long price has held above VWAP.')
show_price_impact = input.bool(true, title='Show Directional Price Response / Float Turnover', group='Display', active=customRowControls, tooltip='Price return in percentage points divided by gross float turnover in percent. Example: +2% price return / 0.5% float turnover = +4.00 pp per 1% turnover. Return basis is selected in Participation / Acceptance. It is a descriptive ratio, not proof that turnover caused the move; very small turnover can produce extreme readings.')
show_directional_efficiency = input.bool(true, title='Show Signed Directional Efficiency', group='Display', active=customRowControls, tooltip='Signed candle body as a percentage of its high-low range: 100*(close-open)/(high-low). +60% means the net rise from open equals 60% of the total range, NOT a 60% share-price gain. Negative means down from open; zero means unchanged from open. This does not measure how smooth the intraday path was. Daily on charts below 1D; current chart period above 1D.')
show_days_liquidate = input.bool(false, title='Show Estimated Days to Liquidate', group='Display', active=customRowControls, tooltip='Estimated full-session-equivalent trading days to sell your entered share position: position shares / (prior completed daily average volume * maximum ADV participation / 100). First enter Optional portfolio position (shares) and Maximum share of daily ADV (%) under Parameters. Zero shares shows Enter position shares. This is not a forecast or an execution guarantee.')
show_data_quality = input.bool(false, title='Show Source / Sample Quality Summary', group='Display', active=customRowControls, tooltip='Data audit, not a trading signal: checks float/share-count consistency and shows actual versus requested observations for risk, same-time relative volume and participation. [FY est.] means annual reported-float approximation; [V-proxy] means a separate volume-based percentile. Counts measure coverage, not statistical reliability. Hover over the table row for diagnostics.')
show_volBuzz = input.bool(true, title='Show Vol. Buzz', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_dolVolBuzz = input.bool(true, title='Show $ Vol. Buzz', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_UDratio = input.bool(true, title='Show U/D Ratio', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_rs_rating = input.bool(true, title='Show RS Rating', group='Display', active=customRowControls, tooltip='Externally calibrated relative-strength percentile estimate on daily and intraday charts; not an official IBD rating. Requires seven valid reference levels. Higher-timeframe charts show an unranked weighted relative-performance ratio versus SPX: 100 means equal weighted relative performance, not a 100th percentile.')
show_liqCap = input.bool(true, title='Show Liquidity Cap', group='Display', active=customRowControls, tooltip='Reference number of shares equal to 1% of prior completed daily average volume. Not a liquidity guarantee or an exchange limit. Separate from the user-selected ADV participation used for Days to Liquidate.')
show_sector = input.bool(true, title='Show Sector', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
show_ind = input.bool(true, title='Show Ind. Grp', group='Display', active=customRowControls, tooltip='Show this metric in the table. Select Custom in Table Preset to edit individual rows. A dash or N/A indicates missing or ineligible data; the selected row remains visible.')
adrp_len          = input.int(20, title='ADR% Length', minval=1, maxval=1260, group='Parameters', tooltip='Average of percentage high-low ranges, over this many chart-period candles.')
adrp_basis = input.string('Low (legacy)', title='ADR% denominator', options=['Low (legacy)','Previous close (comparable)'], group='Parameters', tooltip='Legacy: mean of 100*(high/low - 1). Comparable: mean of 100*(high-low)/previous close. ATR% remains Wilder ATR/current close.')
atr_len           = input.int(14, title='ATR Length', minval=1, maxval=1260, group='Parameters', tooltip='The number of bars used in the calculation of the ATR')
var_len = input.int(252, title='VaR/ES Max Lookback (completed chart bars)', minval=126, maxval=1260, group='Parameters', tooltip='Maximum prior COMPLETED chart-period returns. Daily minimum=126; higher-period floors are configurable. 1% VaR is especially noisy with only 252 returns. Current developing period is ALWAYS excluded.')
min_projection_minutes = input.int(15, title='Earliest time to publish daily volume projection (minutes)', minval=1, maxval=120, group='Parameters', tooltip='Avoid wildly unstable projections from a few opening prints. Historical same-time seasonal fraction must also have at least 21 usable sessions.')
position_shares = input.float(0.0, title='Optional portfolio position (shares)', minval=0.0, group='Parameters', tooltip='Enter your share holding to estimate liquidation days using completed daily average volume. Zero disables the estimate. No private portfolio data is requested or transmitted.')
max_adv_participation_pct = input.float(5.0, title='Maximum share of daily ADV (%)', minval=0.1, maxval=50.0, step=0.5, group='Parameters', tooltip='Simplified liquidation estimate = position shares / (daily ADV × participation%). Not a market-impact model or execution guarantee.')
percentile = input.float(1.0, title='Selected VaR lower-tail percentile (1 or 5 recommended)', minval=0.1, maxval=10.0, step=0.5, group='Parameters')
in_percent        = input(true, title="Result in Percentage", group = 'Parameters') // Added percentage toggle
len               = input.int(50, 'Volume MA Length', minval=1, maxval=1260, group='Parameters', tooltip='The number of bars back for the MA calculation of the volume')
dollar_vol_len    = input.int(50, '$ Volume MA Length', minval=1, maxval=1260, group='Parameters', tooltip='The number of bars back for the MA calculation of the dollar volume') // Added Dollar Volume MA Length
// Relative Volume at Time parameters (designed to run on the 1D chart)
rvat_intratf      = input.string('5', title='RVOL@Time Sampling Resolution (min)', options=['1','3','5','15','30'], group = 'Rel. Vol at Time', tooltip='Historical same-time volume is reconstructed from lower-timeframe bars. The current-day numerator uses live daily volume, so it updates on every market-data update. Use 1 minute for the most precise partial-bar comparison; 5 minutes is the lighter default.')
rvat_mode         = input.string('Cumulative from open', title='RVOL@Time Mode', options=['Cumulative from open','Per-block'], group = 'Rel. Vol at Time', tooltip='Cumulative from open compares today’s total volume so far with the average volume reached at the same elapsed time on prior sessions. Per-block compares only the current rolling block with the matching historical block.')
rvat_block        = input.string('30 min', title='RVOL@Time Block Size (Per-block mode)', options=['15 min','30 min','1 hr','90 min','2 hr','3 hr','4 hr'], group = 'Rel. Vol at Time', tooltip='Used only in Per-block mode. Keep the sampling resolution at or below the selected block size.')
rvat_len          = input.int(21, title='RVOL@Time Max Lookback (chart bars)', minval=6, maxval=1260, group = 'Rel. Vol at Time', tooltip='Maximum valid prior chart periods, not always days. Daily minimum remains 21. Higher-TF default minimum: 10 on day/week multiples, 6 on month multiples. Same-time matching above 1D uses the same session ordinal and session fraction. The selected sampling bar is time-weighted at a partial edge; inspect the tooltip for resolution and actual n.')
rvat_output       = input.string('Difference (+/- %)', title='RVOL@Time Display', options=['Difference (+/- %)','Index (100 = average)','Ratio (x)'], group = 'Rel. Vol at Time', tooltip='Difference is the most literal reading: +50% means volume so far is 50% above the historical same-time average. Index shows 150%; Ratio shows 1.50x.')
participation_len = input.int(252, title='Participation Intensity Percentile Max Lookback (chart bars)', minval=12, maxval=1260, group = 'Participation / Acceptance', tooltip='252 means up to 252 bars of the selected chart timeframe. Set 52 on 1W for up to 52 weekly observations. Daily floor stays 63; higher-TF defaults are 26 on day/week multiples and 12 on month multiples. Partial samples disclose n. Historical FY float remains approximate; the separately labelled volume proxy is retained.')
participation_basis = input.string('Auto (historical float; volume fallback)', title='Participation Percentile Basis', options=['Auto (historical float; volume fallback)', 'Reported historical float only', 'Same-time volume only'], group = 'Participation / Acceptance', tooltip='Auto prefers reported-FY-float turnover when available. If float history is incomplete, it can use a larger valid same-time VOLUME sample once the applicable timeframe minimum is met (63 on 1D; Higher Timeframes settings above 1D). The fallback sample uses one consistent volume basis, never a mixture of actual and guessed float. The row is labelled [proxy].')
adr_pace_len = input.int(63, title='Range Pace @Time Max Lookback (chart bars)', minval=6, maxval=252, group = 'Participation / Acceptance', tooltip='Daily uses ADR; weekly AWR; monthly AMR; other multiples their own average period range. At the period close, pace = period open-to-close return / average period range %. Higher-period history uses completed source intervals only for range progress. Daily floor stays 21; higher floors are disclosed in the tooltip.')
price_impact_basis = input.string('Open to current', title='Price Impact Return Basis', options=['Open to current','Previous close to current'], group = 'Participation / Acceptance', tooltip='Open to current starts at the selected chart period open. Previous close means previous chart-period close. Float turnover uses volume accumulated in that same chart period.')
posTable = input.string('Top Right', title='Table Position', options=['Top Left','Top Centre','Top Right','Middle Left','Middle Centre','Middle Right','Bottom Left','Bottom Centre','Bottom Right'], group='Table')
tbl_size = input.string('Normal', title='Table Size', options=['Tiny','Small','Normal','Large','Extra Large'], group='Table')
txt_align_left    = input.string('Center', title='Left Column Text Align', options=['Left', 'Center', 'Right'], group = 'Table')
txt_align_right   = input.string('Center', title='Right Column Text Align', options=['Left', 'Center', 'Right'], group = 'Table')
bg_col            = input(#00000000, title='Background Color', group = 'Table')
txt_col           = input(color.black, title='Text Color', group = 'Table')  // Changed from orange to white
// Higher-period controls do not change the 1D engine or its sampling settings.
higher_history_tf = input.string('Auto', title='Higher-TF history sampling', options=['Auto','1','3','5','15','30','60','120','240','1D'], group='Higher Timeframes', tooltip='Used only above 1D. Auto balances the requested history against a 100,000-source-bar budget. It can choose coarser intraday or daily bars for long histories. Numerator remains live; partial historical source bars are approximated. The actual resolution is printed in each tooltip. Manual fine resolution can leave a shorter sample. Per-block Auto caps sampling at the block size.')
higher_vwap_tf = input.string('Auto', title='Higher-TF VWAP sampling', options=['Auto','1','3','5','15','30','60'], group='Higher Timeframes', tooltip='Anchors to the CHART candle, not each day. Auto uses 1 minute for ordinary weekly/monthly charts and coarser intraday bars for very long periods to retain a complete anchor. Independent of history sampling. A clipped initial anchor remains unavailable. 1D retains its original 1-minute source and request.')
higher_rank_min = input.int(0, title='Higher-TF percentile minimum (0 = Auto)', minval=0, maxval=252, group='Higher Timeframes', tooltip='Auto: 26 observations for multi-day/weekly bars, 12 for monthly multiples. A nonzero override is floored at 12. These are publication safeguards, not proof of statistical precision. Does not change the 1D floor of 63.')
higher_average_min = input.int(0, title='Higher-TF average minimum (0 = Auto)', minval=0, maxval=252, group='Higher Timeframes', tooltip='Auto: 10 for multi-day/weekly bars, 6 for monthly multiples. Used for RVOL/range shapes and higher-period seasonal projections. Nonzero override is floored at 6. 1D remains 21.')
higher_var_min = input.int(0, title='Higher-TF VaR minimum (0 = Auto)', minval=0, maxval=252, group='Higher Timeframes', tooltip='Auto: 52 completed multi-day/weekly returns or 36 completed monthly-multiple returns. Nonzero override is floored at 36. A 1% tail from a short sample is especially unstable; n is disclosed. Daily remains 126. Floors count observations, not elapsed days.')

simple bool tfOneDay = timeframe.isdaily and timeframe.multiplier == 1
simple bool tfPeriodSupported = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
simple bool tfHigher = tfPeriodSupported and not tfOneDay
// Below 1D the table mirrors the 1D chart. timeframe.main_period stays the CHART timeframe
// inside requests, so this flag means the same thing in the requested 1D contexts below.
simple bool tfIntraday = timeframe.in_seconds(timeframe.main_period) < timeframe.in_seconds('1D')
simple string periodTag = tfIntraday ? '1D' : timeframe.period
simple string periodName = tfOneDay or tfIntraday ? 'Day' : timeframe.isweekly and timeframe.multiplier == 1 ? 'Week' : timeframe.ismonthly and timeframe.multiplier == 1 ? 'Month' : timeframe.period
simple string rangeTag = tfOneDay or tfIntraday ? 'ADR' : timeframe.isweekly and timeframe.multiplier == 1 ? 'AWR' : timeframe.ismonthly and timeframe.multiplier == 1 ? 'AMR' : 'APR'
simple int hRankFloor = higher_rank_min > 0 ? math.max(12, higher_rank_min) : timeframe.ismonthly ? 12 : 26
simple int hAverageFloor = higher_average_min > 0 ? math.max(6, higher_average_min) : timeframe.ismonthly ? 6 : 10
simple int hRiskFloor = higher_var_min > 0 ? math.max(36, higher_var_min) : timeframe.ismonthly ? 36 : 52
simple int hScanLimit = math.min(3000, 2 * math.max(math.max(math.max(rvat_len, participation_len), adr_pace_len), math.max(len, dollar_vol_len)))
// This estimate ONLY selects data resolution. It is NOT a volume projection or a
// trading calendar; actual period/session bounds come from the requested symbol.
simple float hEstimatedMinutes = syminfo.type == 'stock' or syminfo.type == 'fund' or syminfo.type == 'dr' ? (timeframe.ismonthly ? 23.0 * timeframe.multiplier * 600.0 : timeframe.isweekly ? 5.0 * timeframe.multiplier * 600.0 : float(timeframe.multiplier) * 600.0) : timeframe.in_seconds(timeframe.main_period) / 60.0
simple float hTargetMinutes = hEstimatedMinutes * float(hScanLimit) / 85000.0
simple string hAutomaticHistory = hTargetMinutes <= 1 ? '1' : hTargetMinutes <= 3 ? '3' : hTargetMinutes <= 5 ? '5' : hTargetMinutes <= 15 ? '15' : hTargetMinutes <= 30 ? '30' : hTargetMinutes <= 60 ? '60' : hTargetMinutes <= 120 ? '120' : hTargetMinutes <= 240 ? '240' : '1D'
simple int hBlockInputMinutes = rvat_block == '15 min' ? 15 : rvat_block == '30 min' ? 30 : rvat_block == '1 hr' ? 60 : rvat_block == '90 min' ? 90 : rvat_block == '2 hr' ? 120 : rvat_block == '3 hr' ? 180 : 240
simple string hAutoBlockCap = hBlockInputMinutes < 30 ? '15' : hBlockInputMinutes < 60 ? '30' : hBlockInputMinutes < 120 ? '60' : hBlockInputMinutes < 240 ? '120' : '240'
simple string hHistoryChosen = higher_history_tf != 'Auto' ? higher_history_tf : rvat_mode == 'Per-block' and timeframe.in_seconds(hAutomaticHistory) > hBlockInputMinutes * 60 ? hAutoBlockCap : hAutomaticHistory
simple string hHistoryTf = tfHigher ? hHistoryChosen : '1D'
simple float hSamplingSeconds = timeframe.in_seconds(hHistoryTf)
// Budget for at least one full current anchor plus a preceding boundary. Calendar
// minutes are conservative here; this never manufactures a missing native anchor.
simple float hVwapTargetMinutes = 2.0 * timeframe.in_seconds(timeframe.main_period) / 60.0 / 100000.0
simple string hVwapAuto = hVwapTargetMinutes <= 1 ? '1' : hVwapTargetMinutes <= 3 ? '3' : hVwapTargetMinutes <= 5 ? '5' : hVwapTargetMinutes <= 15 ? '15' : hVwapTargetMinutes <= 30 ? '30' : '60'
simple string hVwapTf = higher_vwap_tf == 'Auto' ? hVwapAuto : higher_vwap_tf

// Switch Table Position
tablePos = switch posTable
    'Top Left' => position.top_left
    'Top Centre' => position.top_center
    'Top Right' => position.top_right
    'Middle Left' => position.middle_left
    'Middle Centre' => position.middle_center
    'Middle Right' => position.middle_right
    'Bottom Left' => position.bottom_left
    'Bottom Centre' => position.bottom_center
    'Bottom Right' => position.bottom_right
// Switch Label Size
size_tbl = switch tbl_size
    'Normal'  => size.normal
    'Tiny'    => size.tiny
    'Small'   => size.small
    'Large'   => size.large
    'Extra Large' => size.huge
// Switch Text Align
align_txt_left = switch txt_align_left
    'Left'   => text.align_left
    'Center' => text.align_center
    'Right'  => text.align_right
align_txt_right = switch txt_align_right
    'Left'   => text.align_left
    'Center' => text.align_center
    'Right'  => text.align_right
// Helpers
// Sum lower-timeframe values across a timestamp window. A partial edge bar is
// time-weighted so the historical denominator advances with the live clock.
f_windowSum(array<float> values, array<int> starts, array<int> ends, int fromTs, int toTs) =>
    float total = 0.0
    bool found = false
    if not na(values) and not na(starts) and not na(ends) and not na(fromTs) and not na(toTs) and toTs > fromTs
        int n = math.min(array.size(values), math.min(array.size(starts), array.size(ends)))
        if n > 0
            for j = 0 to n - 1
                int barStart = array.get(starts, j)
                int barEnd = array.get(ends, j)
                if barStart >= toTs
                    break
                if barEnd > fromTs and barStart < toTs and barEnd > barStart
                    int overlapStart = math.max(barStart, fromTs)
                    int overlapEnd = math.min(barEnd, toTs)
                    if overlapEnd > overlapStart
                        float fraction = float(overlapEnd - overlapStart) / float(barEnd - barStart)
                        total += array.get(values, j) * fraction
                        found := true
    found ? total : na
// Sum only fully closed intrabars. If the provider includes a developing intrabar in the array,
// it is deliberately excluded and recovered from the live daily-volume residual instead.
f_closedSum(array<float> values, array<int> starts, array<int> ends, int fromTs, int cutoffTs) =>
    float total = 0.0
    bool found = false
    if not na(values) and not na(starts) and not na(ends) and not na(fromTs) and not na(cutoffTs) and cutoffTs > fromTs
        int n = math.min(array.size(values), math.min(array.size(starts), array.size(ends)))
        if n > 0
            for j = 0 to n - 1
                int barStart = array.get(starts, j)
                int barEnd = array.get(ends, j)
                if barStart >= cutoffTs or barEnd > cutoffTs
                    break
                if barStart >= fromTs and barEnd > barStart
                    total += array.get(values, j)
                    found := true
    found ? total : na
// Return the high and low reached inside a timestamp window using only fully completed
// lower-timeframe bars. This avoids leaking the remainder of a historical sampling bar
// into the same-time ADR pace estimate. Use 1-minute sampling for the finest intraday read.
f_windowHighLow(array<float> highs, array<float> lows, array<int> starts, array<int> ends, int fromTs, int toTs) =>
    float winHigh = na
    float winLow = na
    if not na(highs) and not na(lows) and not na(starts) and not na(ends) and not na(fromTs) and not na(toTs) and toTs > fromTs
        int n = math.min(math.min(array.size(highs), array.size(lows)), math.min(array.size(starts), array.size(ends)))
        if n > 0
            for j = 0 to n - 1
                int barStart = array.get(starts, j)
                int barEnd = array.get(ends, j)
                if barStart >= toTs or barEnd > toTs
                    break
                if barStart >= fromTs and barEnd > barStart
                    float h = array.get(highs, j)
                    float l = array.get(lows, j)
                    winHigh := na(winHigh) ? h : math.max(winHigh, h)
                    winLow := na(winLow) ? l : math.min(winLow, l)
    [winHigh, winLow]
// Return the first/last available lower-timeframe timestamp.
f_firstTimestamp(array<int> values) =>
    int result = na
    if not na(values) and array.size(values) > 0
        result := array.get(values, 0)
    result
f_lastTimestamp(array<int> values) =>
    int result = na
    if not na(values) and array.size(values) > 0
        result := array.get(values, array.size(values) - 1)
    result
// A regular-session daily bar must have a positive, plausible duration. If the data provider
// does not supply defensible session bounds, the advanced same-time metrics return "-" rather
// than guessing from the first or last trade of an incomplete/illiquid session.
f_sessionBoundsValid(int sessionStart, int sessionEnd) =>
    int sessionSpan = not na(sessionStart) and not na(sessionEnd) ? sessionEnd - sessionStart : 0
    sessionSpan >= 30 * 60 * 1000 and sessionSpan <= 16 * 60 * 60 * 1000
// These functions execute IN the requested lower-timeframe context on every source bar.
// Its cumulative volume is independent of the arrays returned to the daily chart. Comparing
// them detects a dropped prefix/internal slice without assuming a trade at the opening bell.
f_nativeSessionVolume() =>
    var float cumulative = 0.0
    cumulative := timeframe.change('D') ? volume : cumulative + volume
    cumulative

// The first source session can begin part-way through a day at calc_bars_count's boundary.
// Even a self-consistent cumulative total is not proof of completeness on that first day.
// Exclude it conservatively; the valid-observation scan can replace it with another session.
f_nativeSessionReady() =>
    var int firstSourceSession = time('D')
    time('D') != firstSourceSession

// Status: 0 = usable, 1 = no intrabars, 2 = first/possibly clipped source session,
// 3 = malformed arrays/session timestamps, 4 = source cumulative-volume mismatch.
// A late first trade or an early last trade is NOT, by itself, missing data.
// This validates retrieval from the supplied intraday feed, not the exchange's entire tape.
f_sessionDataStatus(array<float> values, array<int> starts, array<int> ends, array<float> nativeCumulative, array<bool> nativeReady, int sessionStart, int sessionEnd) =>
    int status = 1
    bool arraysExist = not na(values) and not na(starts) and not na(ends) and not na(nativeCumulative) and not na(nativeReady)
    if arraysExist
        int n = array.size(values)
        if n > 0
            status := 3
            bool sizesMatch = array.size(starts) == n and array.size(ends) == n and array.size(nativeCumulative) == n and array.size(nativeReady) == n
            if sizesMatch and f_sessionBoundsValid(sessionStart, sessionEnd)
                int firstStart = array.get(starts, 0)
                int lastEnd = array.get(ends, n - 1)
                bool timestampsValid = not na(firstStart) and not na(lastEnd) and firstStart >= sessionStart and lastEnd <= sessionEnd and lastEnd > firstStart
                if timestampsValid
                    if not array.get(nativeReady, 0) or not array.get(nativeReady, n - 1)
                        status := 2
                    else
                        float rawTotal = array.sum(values)
                        float nativeFirst = array.get(nativeCumulative, 0)
                        float nativeLast = array.get(nativeCumulative, n - 1)
                        float firstVolume = array.get(values, 0)
                        float smallestVolume = array.min(values)
                        float tolerance = math.max(0.000001, math.abs(nz(nativeLast)) * 0.00000001)
                        bool totalsValid = not na(rawTotal) and not na(nativeFirst) and not na(nativeLast) and not na(firstVolume) and not na(smallestVolume) and smallestVolume >= 0 and rawTotal >= 0 and math.abs(nativeFirst - firstVolume) <= tolerance and math.abs(nativeLast - rawTotal) <= tolerance
                        status := totalsValid ? 0 : 4
    status
// A derived relative-strength percentile, NOT an official IBD rank.
// The GitHub request.seed calibration source may be missing or stale. Never
// fabricate a 1-99 reading unless seven strictly ordered levels are present.
// Scan only on the final source bar to reduce execution cost.
f_rsCalibrated(float currentScore, float seedSeries) =>
    float rating = na
    if barstate.islast and not na(currentScore) and currentScore > 0
        array<float> levels = array.new_float(0)
        int scan = math.min(500, bar_index)
        if scan >= 6
            for i = 0 to scan
                float level = seedSeries[i]
                if not na(level) and level > 0 and not array.includes(levels, level)
                    array.push(levels, level)
                    if array.size(levels) >= 7
                        break
        if array.size(levels) == 7
            bool strictlyOrdered = true
            for j = 1 to 6
                if array.get(levels, j - 1) <= array.get(levels, j)
                    strictlyOrdered := false
            if strictlyOrdered
                float topLevel = array.get(levels, 0)
                float bottomLevel = array.get(levels, 6)
                if currentScore >= topLevel
                    rating := 99.0
                else if currentScore <= bottomLevel
                    rating := 1.0
                else
                    for j = 0 to 5
                        float upper = array.get(levels, j)
                        float lower = array.get(levels, j + 1)
                        if currentScore < upper and currentScore >= lower
                            float highRank = j == 0 ? 98.0 : j == 1 ? 89.0 : j == 2 ? 69.0 : j == 3 ? 49.0 : j == 4 ? 29.0 : 9.0
                            float lowRank = j == 0 ? 90.0 : j == 1 ? 70.0 : j == 2 ? 50.0 : j == 3 ? 30.0 : j == 4 ? 10.0 : 2.0
                            rating := lowRank + (currentScore - lower) / (upper - lower) * (highRank - lowRank)
                            break
    rating

// Convert a lower-timeframe window into an exact daily-feed-equivalent figure. The intraday
// arrays determine what fraction of the session's volume had traded by the target time; the
// confirmed regular-session daily total supplies the economic scale. This prevents DWM/LTF feed
// differences from creating an artificially tiny or huge historical denominator.
f_scaledHistoricalWindow(array<float> values, array<int> starts, array<int> ends, int sessionStart, int windowStart, int windowEnd, int sessionEnd, float exactDailyTotal) =>
    float rawWindow = f_windowSum(values, starts, ends, windowStart, windowEnd)
    float rawFull = f_windowSum(values, starts, ends, sessionStart, sessionEnd)
    float result = na
    // The caller validates the session first. No trades inside a valid window means ZERO,
    // not an unavailable observation. A missing full-session array still returns na.
    bool validWindow = not na(windowStart) and not na(windowEnd) and windowEnd > windowStart and windowStart >= sessionStart and windowEnd <= sessionEnd
    if validWindow and not na(rawFull) and rawFull > 0 and not na(exactDailyTotal) and exactDailyTotal > 0
        float completionFraction = math.min(math.max(nz(rawWindow, 0.0) / rawFull, 0.0), 1.0)
        result := exactDailyTotal * completionFraction
    result
f_compactNumber(float value) =>
    string result = '-'
    if not na(value)
        result := math.abs(value) >= 1000000000 ? str.tostring(value / 1000000000.0, '0.00') + 'B' : math.abs(value) >= 1000000 ? str.tostring(value / 1000000.0, '0.00') + 'M' : math.abs(value) >= 1000 ? str.tostring(value / 1000.0, '0.00') + 'K' : str.tostring(value, '0')
    result
f_signedPct(float value, string pattern) =>
    na(value) ? '-' : (value > 0 ? '+' : '') + str.tostring(value, pattern) + '%'
f_signedNumber(float value, string pattern, string suffix) =>
    na(value) ? '-' : (value > 0 ? '+' : '') + str.tostring(value, pattern) + suffix

// Expected Shortfall reference: average of the worst ceil(alpha*n) COMPLETED
// returns. Unlike an empirical quantile, this describes realised tail severity.
// This function is only called on the last source bar to avoid heavy per-bar sorting.
f_recentES(float returnsSeries, int priorSampleCount, float alphaPercent) =>
    float result = na
    if priorSampleCount > 0
        array<float> completed = array.new_float(0)
        for j = 1 to priorSampleCount
            float observed = returnsSeries[j]
            if not na(observed)
                array.push(completed, observed)
        int validN = array.size(completed)
        if validN >= priorSampleCount
            array.sort(completed, order.ascending)
            int tailN = math.max(1, int(math.ceil(validN * alphaPercent / 100.0)))
            float tailSum = 0.0
            for j = 0 to tailN - 1
                tailSum += array.get(completed, j)
            result := tailSum / tailN
    result
// Execute the entire VWAP calculation in ONE intraday source context. The cumulative
// result returned on its latest minute already includes earlier source minutes; it is
// NOT the VWAP of only the final minute. Native ta.vwap handles the developing source bar.
// This feed-consistent calculation is independent of the RVOL history-sampling input.
// The initial source session may be clipped by calc_bars_count, so it is not published.
f_dailyVwapSnapshot() =>
    bool newSourceSession = timeframe.change('1D')
    float sourceVWAP = ta.vwap(hlc3, newSourceSession)
    var int firstSourceSession = time('1D')
    var float sourceVolume = 0.0
    var bool invalidSource = false
    if newSourceSession
        sourceVolume := 0.0
        invalidSource := false
    if na(volume) or volume < 0
        invalidSource := true
    else
        sourceVolume += volume
        if volume > 0 and (na(hlc3) or hlc3 <= 0)
            invalidSource := true
    bool sourceReady = time('1D') != firstSourceSession and not invalidSource
    [sourceVWAP, sourceVolume, time('1D'), time, time_close, close, sourceReady]

// Higher-timeframe history carries a TRADING-SESSION coordinate, not elapsed calendar
// time. 2.5 means two completed sessions plus half of the third session. Nights,
// weekends and holidays without a session do not advance this coordinate.
// This daily-source counter is independent of the historical intraday request.
f_hDailyCalendar() =>
    int anchor = time(timeframe.main_period)
    bool reset = timeframe.change(timeframe.main_period)
    var int firstAnchor = anchor
    var int dayNumber = 0
    if reset
        dayNumber := 0
    dayNumber += 1
    [anchor, dayNumber, time, time_close, anchor != firstAnchor]

// Runs in the chosen historical sampling context. The native cumulative volume
// and session count allow a clipped/missing prefix to be rejected, not undercounted.
f_hSource() =>
    int anchor = time(timeframe.main_period)
    bool reset = timeframe.change(timeframe.main_period)
    bool newDay = timeframe.change('1D')
    var int firstAnchor = anchor
    var int dayNumber = 0
    var float cumulative = 0.0
    var bool invalid = false
    if reset
        dayNumber := 0
        cumulative := 0.0
        invalid := false
    if reset or newDay or dayNumber == 0
        dayNumber += 1
    if na(volume) or volume < 0
        invalid := true
    else
        cumulative += volume
    int ds = time('1D')
    int de = time_close('1D')
    float duration = float(de - ds)
    float a = duration > 0 ? float(dayNumber - 1) + float(time - ds) / duration : na
    float b = duration > 0 ? float(dayNumber - 1) + float(time_close - ds) / duration : na
    bool ready = anchor != firstAnchor and not invalid
    [volume, time, time_close, hlc3 * volume, high, low, a, b, cumulative, ready, dayNumber]

// Full-period validation. Sparse prints are allowed; missing source sessions are
// detected by checking the source day count against the independent DAILY context.
f_hStatus(array<float> vols, array<int> starts, array<int> ends, array<float> aa, array<float> bb, array<float> nativeVol, array<bool> ready, array<int> dayNo, int ps, int pe, int expectedDays, bool calendarReady) =>
    int status = 1
    bool exists = not na(vols) and not na(starts) and not na(ends) and not na(aa) and not na(bb) and not na(nativeVol) and not na(ready) and not na(dayNo)
    if exists
        int n = array.size(vols)
        if n > 0
            status := 3
            bool sizes = array.size(starts) == n and array.size(ends) == n and array.size(aa) == n and array.size(bb) == n and array.size(nativeVol) == n and array.size(ready) == n and array.size(dayNo) == n
            if sizes and not na(ps) and not na(pe) and pe > ps
                int s0 = array.get(starts, 0)
                int en = array.get(ends, n - 1)
                bool times = not na(s0) and not na(en) and s0 >= ps and en <= pe and en > s0
                if times
                    if not array.get(ready, 0) or not array.get(ready, n - 1) or not calendarReady
                        status := 2
                    else if na(expectedDays) or expectedDays <= 0 or array.get(dayNo, 0) != 1 or array.get(dayNo, n - 1) != expectedDays
                        status := 5
                    else
                        float total = array.sum(vols)
                        float v0 = array.get(vols, 0)
                        float nv0 = array.get(nativeVol, 0)
                        float nvn = array.get(nativeVol, n - 1)
                        float smallest = array.min(vols)
                        float tol = math.max(0.000001, math.abs(nz(nvn)) * 0.00000001)
                        bool valid = not na(total) and not na(v0) and not na(nv0) and not na(nvn) and not na(smallest) and smallest >= 0 and math.abs(v0 - nv0) <= tol and math.abs(total - nvn) <= tol
                        float firstCoord = array.get(aa, 0)
                        float lastCoord = array.get(bb, n - 1)
                        valid := valid and not na(firstCoord) and not na(lastCoord) and firstCoord >= 0 and firstCoord < 1 and lastCoord <= float(expectedDays) + 0.000001
                        status := valid ? 0 : 4
    status

// A partial historical edge interval is linearly time-weighted. This is an
// explicitly disclosed approximation within that sampling bar, not exact tick data.
f_hWindow(array<float> values, array<float> aa, array<float> bb, float fromCoord, float toCoord) =>
    float result = na
    if not na(values) and not na(aa) and not na(bb) and not na(fromCoord) and not na(toCoord) and toCoord >= fromCoord
        int n = array.size(values)
        if n > 0 and array.size(aa) == n and array.size(bb) == n
            result := 0.0
            if toCoord > fromCoord
                for j = 0 to n - 1
                    float a = array.get(aa, j)
                    float b = array.get(bb, j)
                    if a >= toCoord
                        break
                    if b > fromCoord and b > a
                        float overlap = math.max(0.0, math.min(b, toCoord) - math.max(a, fromCoord))
                        result += array.get(values, j) * overlap / (b - a)
    result

f_hHighLow(array<float> hh, array<float> ll, array<float> bb, float toCoord) =>
    float h = na
    float l = na
    if not na(hh) and not na(ll) and not na(bb) and not na(toCoord)
        int n = array.size(hh)
        if n > 0 and array.size(ll) == n and array.size(bb) == n
            for j = 0 to n - 1
                if array.get(bb, j) > toCoord + 0.0000001
                    break
                float hj = array.get(hh, j)
                float lj = array.get(ll, j)
                h := na(h) ? hj : math.max(h, hj)
                l := na(l) ? lj : math.min(l, lj)
    [h, l]

// Used ONLY for current-period per-block volume. Exclude the developing source bar;
// the cumulative period-volume numerator remains live in cumulative mode.
f_hClosedVolume(array<float> vols, array<int> ends, array<float> aa, array<float> bb, float fromCoord, float toCoord, int cutoff) =>
    float result = na
    if not na(vols) and not na(ends) and not na(aa) and not na(bb)
        int n = array.size(vols)
        if n > 0 and array.size(ends) == n and array.size(aa) == n and array.size(bb) == n
            result := 0.0
            for j = 0 to n - 1
                if array.get(ends, j) > cutoff
                    break
                float a = array.get(aa, j)
                float b = array.get(bb, j)
                if a >= toCoord
                    break
                if b > fromCoord and b > a
                    float overlap = math.max(0.0, math.min(b, toCoord) - math.max(a, fromCoord))
                    result += array.get(vols, j) * overlap / (b - a)
    result

// A separate anchor for >1D. timeframe.main_period is invariant inside requests.
f_hVwapSnapshot() =>
    bool reset = timeframe.change(timeframe.main_period)
    int anchor = time(timeframe.main_period)
    float result = ta.vwap(hlc3, reset)
    var int firstAnchor = anchor
    var float cumulative = 0.0
    var bool invalid = false
    if reset
        cumulative := 0.0
        invalid := false
    if na(volume) or volume < 0
        invalid := true
    else
        cumulative += volume
        if volume > 0 and (na(hlc3) or hlc3 <= 0)
            invalid := true
    [result, cumulative, anchor, time, time_close, close, anchor != firstAnchor and not invalid]

// Calculation
// ADR/ATR
tf    = timeframe.period
s     = syminfo.tickerid
float arpLegacy = 100 * (ta.sma(low > 0 ? high / low : na, adrp_len) - 1)
float arpComparable = 100 * ta.sma(close[1] > 0 ? (high - low) / close[1] : na, adrp_len)
arp = adrp_basis == 'Low (legacy)' ? arpLegacy : arpComparable
atr       = ta.atr(atr_len)
atrp      = 100 * (atr/close)
lod_dist  = 100 * (close - low) / atr
lod_price = low
// Intraday mirror (below 1D only). This function runs in the chart symbol's own 1D context,
// so every length and [n] offset counts DAILY bars, exactly as on the 1D chart. The formulas
// are copied from the 1D chart path; the 1D and higher charts never read these values.
f_iChartDaily() =>
    float dArpLegacy = 100 * (ta.sma(low > 0 ? high / low : na, adrp_len) - 1)
    float dArpComparable = 100 * ta.sma(close[1] > 0 ? (high - low) / close[1] : na, adrp_len)
    float dArp = adrp_basis == 'Low (legacy)' ? dArpLegacy : dArpComparable
    float dAtr = ta.atr(atr_len)
    float dRt = close / close[1] - 1
    float dReturn = in_percent ? dRt * 100 : dRt
    // On ANY chart the daily mirror judges risk from prior completed days.
    int dVarCount = math.max(0, math.min(var_len, bar_index - 1))
    int dVarLength = math.max(dVarCount, 1)
    float dVarRaw = ta.percentile_linear_interpolation(dReturn[1], dVarLength, percentile)
    float dVar5Raw = ta.percentile_linear_interpolation(dReturn[1], dVarLength, 5.0)
    float dStdRaw = ta.stdev(dReturn[1], dVarLength)
    bool dVarReady = dVarCount >= 126
    float dVaR = dVarReady ? dVarRaw : na
    float dVaR5 = dVarReady ? dVar5Raw : na
    float dStd = dVarReady ? dStdRaw : na
    float dStress = dVarReady ? dVaR - (3.0 * dStd) : na
    float dES5 = dVarReady and barstate.islast ? f_recentES(dReturn, dVarCount, 5.0) : na
    float dVolumeMA = ta.sma(volume[1], len)
    float dDollarVolumeMA = ta.sma(volume[1] * close[1], dollar_vol_len)
    float dUpVol = close > close[1] ? volume : 0
    float dDnVol = close < close[1] ? volume : 0
    float dDownVolume = math.sum(dDnVol, 50)
    float dUpDnRatio = dDownVolume > 0 ? math.sum(dUpVol, 50) / dDownVolume : na
    // RS score: same weights and IPO-safe horizons, counted in daily bars.
    float dSpx = request.security('SP:SPX', 'D', close)
    int d63 = bar_index < 63 ? bar_index : 63
    int d126 = bar_index < 126 ? bar_index : 126
    int d189 = bar_index < 189 ? bar_index : 189
    int d252 = bar_index < 252 ? bar_index : 252
    float dRsStock = 0.4 * (close / close[d63]) + 0.2 * (close / close[d126]) + 0.2 * (close / close[d189]) + 0.2 * (close / close[d252])
    float dRsRef = 0.4 * (dSpx / dSpx[d63]) + 0.2 * (dSpx / dSpx[d126]) + 0.2 * (dSpx / dSpx[d189]) + 0.2 * (dSpx / dSpx[d252])
    float dRsScore = not na(dRsRef) and dRsRef > 0 ? dRsStock / dRsRef * 100.0 : na
    // Only an intact, strictly ordered external calibration is considered valid.
    float dSeed = request.seed('seed_fred6725_rs_rating', 'RSRATING', close)
    float dRsRating = f_rsCalibrated(dRsScore, dSeed)
    [dArp, dArpComparable, dAtr, 100 * (dAtr / close), 100 * (close - low) / dAtr, low, dVaR, dVaR5, dES5, dStd, dStress, dVarCount, dVarReady, volume, dVolumeMA, dDollarVolumeMA, time, time_close, close, dUpDnRatio, dRsScore, dRsRating]
[iArp, iArpComparable, iAtr, iAtrp, iLodDist, iLodPrice, iVaR, iVaR5, iES5, iVarStd, iVarStress, iVarCount, iVarReady, iDayVolume, iDayVolumeMA, iDayDollarVolumeMA, iDayStart, iDayEnd, iDayClose, iUpDnVolRatio, iRsScore, iRsRating] = request.security(s, '1D', f_iChartDaily(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=tfIntraday ? 100000 : 2)
// VaR Calculation
// Historical one-day empirical VaR. The selected lookback is a MAXIMUM, not a hard maturity gate.
// Publish only when at least 126 daily returns exist; otherwise show '-'.
rt_formula = close / close[1] - 1
return_ = in_percent ? rt_formula * 100 : rt_formula
int varMinimumSamples = 126
// Exclude the CURRENT day's developing/closed return; use 1..N prior returns.
// bar_index-1 counts how many completed return pairs lie strictly before now.
int varSampleCount = math.max(0, math.min(var_len, bar_index - 1))
int varCalcLength = math.max(varSampleCount, 1)
float VaR_raw = ta.percentile_linear_interpolation(return_[1], varCalcLength, percentile)
float VaR5_raw = ta.percentile_linear_interpolation(return_[1], varCalcLength, 5.0)
float std_dev_returns_raw = ta.stdev(return_[1], varCalcLength)
bool varSampleReady = varSampleCount >= varMinimumSamples
float VaR = varSampleReady ? VaR_raw : na
float VaR5 = varSampleReady ? VaR5_raw : na
float ES5 = varSampleReady and barstate.islast ? f_recentES(return_, varSampleCount, 5.0) : na
float std_dev_returns = varSampleReady ? std_dev_returns_raw : na
// Optional custom severity heuristic, NOT a second VaR confidence level.
float VaR_plus_3sigma = varSampleReady ? VaR - (3.0 * std_dev_returns) : na
// Below 1D, every daily-bar statistic above takes the 1D-chart value requested above.
if tfIntraday
    arp := iArp
    arpComparable := iArpComparable
    atr := iAtr
    atrp := iAtrp
    lod_dist := iLodDist
    lod_price := iLodPrice
    varSampleCount := iVarCount
    varSampleReady := iVarReady
    VaR := iVaR
    VaR5 := iVaR5
    ES5 := iES5
    std_dev_returns := iVarStd
    VaR_plus_3sigma := iVarStress
string varSampleSuffix = varSampleReady and varSampleCount < var_len ? ' (n=' + str.tostring(varSampleCount) + ')' : ''
string varTooltip = 'Historical lower-tail VaR (' + str.tostring(percentile) + '%) from COMPLETED returns before the current chart period. Maximum n=' + str.tostring(var_len) + ', current n=' + str.tostring(varSampleCount) + ', required minimum=' + str.tostring(varMinimumSamples) + '. A 1% tail with 252 observations has only ~2.5 expected tail observations: this is a noisy quantile, not the worst possible loss.'
string var5Tooltip = 'Separate historical 5% signed return quantile from the same completed-period sample. The displayed percentage is a return threshold, not a guaranteed loss limit. n=' + str.tostring(varSampleCount) + '.'
string esTooltip = 'Historical Expected Shortfall at 5% = average of the worst ceil(5% × n) completed returns in the same sample (no look-ahead to the current period). Unlike VaR this measures observed tail severity; small n still means considerable uncertainty. n=' + str.tostring(varSampleCount) + '.'
string tailQuality = 'Completed returns=' + str.tostring(varSampleCount) + ', expected 1% tail count≈' + str.tostring(varSampleCount * 0.01, '0.0') + '. ' + (varSampleCount < 500 ? 'CAUTION: thin 1% tail.' : 'Tail coverage improved but still model-dependent.')
string stressTooltip = 'Stress overlay = VaR - 3σ, where σ is the standard deviation of the same adaptive daily-return sample. This is a severity stress measure, not a separate conventional VaR confidence level. Current n=' + str.tostring(varSampleCount) + '.'
// Available daily price-history duration (NOT a verified company IPO date).
ipoSince = request.security(s, 'D', (bar_index+1)/252.0)
// Volume
vol   = request.security(s, tf, volume)
ma = ta.sma(vol[1], len)
// 1) Relative Volume
relVol = not na(ma) and ma > 0 ? vol / ma * 100.0 : na
// Tracks whether the first 30 minutes reached 50% of normal full-day volume.
// The value is resolved below from regular-session intrabars so it also works
// on the 1D chart, where session.ismarket alone cannot identify the opening window.
bool relVolExceeded50InFirst30Min = false
// 1b) Relative Volume at Time and participation/acceptance metrics.
// These calculations are intended for the 1D chart. The comparison window is
// defined by elapsed regular-session clock time rather than by array position.
rvat_block_min = switch rvat_block
    '15 min' => 15
    '30 min' => 30
    '1 hr'   => 60
    '90 min' => 90
    '2 hr'   => 120
    '3 hr'   => 180
    '4 hr'   => 240
    => 30
// Use a regular-session ticker so pre-market/post-market prints do not distort
// the same-time comparison for equities.
regularTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[rvatDailyOpen, rvatDailyHigh, rvatDailyLow, rvatDailyClose, rvatDailyVolume, rvatDailyStart, rvatDailyEnd, rvatPreviousClose] = request.security(regularTicker, 'D', [open, high, low, close, volume, time, time_close, close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
// Only the current session's cumulative VWAP snapshot is needed. Request a separate,
// short 1-minute history, rather than coupling price accuracy to RVOL's sampling setting.
// lookahead_off selects the latest intrabar result; all accumulation happens in the source.
[vwapNativeValue, vwapNativeVolume, vwapNativeSession, vwapNativeBarStart, vwapNativeBarEnd, vwapNativeClose, vwapNativeReady] = request.security(regularTicker, '1', f_dailyVwapSnapshot(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=5000)
// 100,000 intrabars is a per-request budget on many plans, covering roughly 252 standard
// 390-minute US equity sessions at 1-minute resolution. Longer-session markets may return fewer
// than 252 comparable sessions at 1 minute; the table reports the actual usable sample size.
[rvatIntraVols, rvatIntraStarts, rvatIntraEnds, rvatIntraPV, rvatIntraHighs, rvatIntraLows, rvatIntraNativeVolume, rvatIntraNativeReady] = request.security_lower_tf(regularTicker, rvat_intratf, [volume, time, time_close, hlc3 * volume, high, low, f_nativeSessionVolume(), f_nativeSessionReady()], ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=tfIntraday ? 2 : 100000)
// TradingView exposes historical float shares as an annual financial series.
// The live syminfo value is preferred for today's denominator; prior sessions
// use the annual series as the native point-in-time history available in Pine.
floatFYSeries = request.financial(s, 'FLOAT_SHARES_OUTSTANDING', 'FY', gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float_live = syminfo.shares_outstanding_float
FSO = na(float_live) or float_live <= 0 ? floatFYSeries : float_live
// Parallel requests for higher chart periods. Same-symbol, regular-hours context.
// Inactive higher-history requests are deliberately tiny on the 1D chart.
[hPeriodOpen, hPeriodHigh, hPeriodLow, hPeriodClose, hPeriodVolume, hPeriodStart, hPeriodEnd, hPreviousClose] = request.security(regularTicker, timeframe.period, [open, high, low, close, volume, time, time_close, close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[hCalendarKey, hDayCount, hCalendarDayStart, hCalendarDayEnd, hCalendarReady] = request.security(regularTicker, '1D', f_hDailyCalendar(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=100000)
[hVols, hStarts, hEnds, hPVs, hHighs, hLows, hCoordsA, hCoordsB, hNativeVols, hReady, hDayNumbers] = request.security_lower_tf(regularTicker, hHistoryTf, f_hSource(), ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=tfHigher ? 100000 : 2)
[hVwap, hVwapVolume, hVwapKey, hVwapStart, hVwapEnd, hVwapClose, hVwapReady] = request.security(regularTicker, hVwapTf, f_hVwapSnapshot(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=tfHigher ? 100000 : 2)
// One requested object carries the intraday mirror's results. Pine caps the combined size of
// all requested tuples at 127 elements; an object keeps this build well inside that budget.
type IntradayDailyEngine
    int sessionStart
    int cutoff
    int elapsedMs
    float firstThirtyVolume
    float today
    float intensity
    float rvatAverage
    float rvatFullDayAvg
    float rvatCompletion
    float projectionShareCompletion
    float projectionDollarCompletion
    int projectionSharesN
    int projectionDollarN
    float reportedPctile
    float volumePctile
    float adrProgressAvg
    int rvatCount
    int reportedCount
    int volumeCount
    int adrCount
    int scanned
    int badDaily
    int shortSessions
    int noIntrabars
    int sourceBoundary
    int malformed
    int mismatch
    int missingFloat
    int noRange
    int sparseAccepted
    int zeroWindows
    int rvatOldest
    int rvatNewest
    int rvatOldestBack
    int reportedOldest
    int reportedNewest
    int reportedOldestBack
    int volumeOldest
    int volumeNewest
    int volumeOldestBack
    int adrOldest
    int adrNewest
    int adrOldestBack

// Intraday mirror of the 1D same-time engine (below 1D only). It runs in the regular-session
// 1D context, so [i] means i daily sessions back and each nested intrabar array belongs to one
// daily session, exactly as on the 1D chart. The 1D engine below is not altered; this copy of
// its logic only feeds intraday charts. 21 and 63 are the unchanged 1D publication floors.
f_iDailyEngine() =>
    [eVols, eStarts, eEnds, ePVs, eHighs, eLows, eNativeVolume, eNativeReady] = request.security_lower_tf(regularTicker, rvat_intratf, [volume, time, time_close, hlc3 * volume, high, low, f_nativeSessionVolume(), f_nativeSessionReady()], ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=tfIntraday ? 100000 : 2)
    float eFloatFY = request.financial(s, 'FLOAT_SHARES_OUTSTANDING', 'FY', gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
    float eFloatLive = syminfo.shares_outstanding_float
    float eFSO = na(eFloatLive) or eFloatLive <= 0 ? eFloatFY : eFloatLive
    int sessionStart = time
    int sessionEnd = time_close
    int blockMs = rvat_block_min * 60 * 1000
    int samplingMs = int(timeframe.in_seconds(rvat_intratf) * 1000)
    int scanLimit = math.min(3000, 2 * math.max(math.max(math.max(rvat_len, participation_len), adr_pace_len), math.max(len, dollar_vol_len)))
    bool resolutionCompatible = rvat_mode == 'Cumulative from open' or samplingMs <= blockMs
    bool collectReported = participation_basis != 'Same-time volume only'
    bool collectVolume = participation_basis != 'Reported historical float only'
    bool dailyReady = f_sessionBoundsValid(sessionStart, sessionEnd) and not na(volume)
    bool sessionActive = dailyReady and timenow >= sessionStart and timenow < sessionEnd
    bool sessionComplete = dailyReady and timenow >= sessionEnd
    bool sessionUsable = tfIntraday and barstate.islast and (sessionActive or sessionComplete)
    int cutoff = na
    int elapsedMs = 0
    int sessionMs = 0
    int blockStartElapsed = 0
    float firstThirtyVolume = na
    if sessionUsable
        sessionMs := sessionEnd - sessionStart
        cutoff := sessionActive ? math.min(math.max(timenow, sessionStart + 1), sessionEnd - 1) : sessionEnd
        elapsedMs := math.max(cutoff - sessionStart, 0)
        int firstThirtyEnd = math.min(sessionStart + 30 * 60 * 1000, sessionEnd)
        firstThirtyVolume := elapsedMs <= 30 * 60 * 1000 ? volume : f_windowSum(eVols, eStarts, eEnds, sessionStart, firstThirtyEnd)
        if elapsedMs > 0 and blockMs > 0
            int elapsedForBlock = elapsedMs >= sessionMs and sessionMs > 0 ? sessionMs - 1 : elapsedMs
            int blockIndex = int(math.floor(float(math.max(elapsedForBlock, 0)) / float(blockMs)))
            blockStartElapsed := blockIndex * blockMs
    float today = na
    float intensity = na
    float rvatAvg = na
    float rvatFullAvg = na
    float rvatCompletion = na
    float projShareFraction = na
    float projDollarFraction = na
    float reportedPctile = na
    float volumePctile = na
    float adrProgressAvg = na
    int rvatCount = 0
    int reportedCount = 0
    int volumeCount = 0
    int adrCount = 0
    int scanned = 0
    int badDaily = 0
    int shortSessions = 0
    int noIntrabars = 0
    int sourceBoundary = 0
    int malformed = 0
    int mismatch = 0
    int missingFloat = 0
    int noRange = 0
    int sparseAccepted = 0
    int zeroWindows = 0
    int rvatOldest = na
    int rvatNewest = na
    int rvatOldestBack = 0
    int reportedOldest = na
    int reportedNewest = na
    int reportedOldestBack = 0
    int volumeOldest = na
    int volumeNewest = na
    int volumeOldestBack = 0
    int adrOldest = na
    int adrNewest = na
    int adrOldestBack = 0
    // Function-scope counters: the returned engine object uses these even when
    // no session is usable. Keep them outside the conditional calculation block.
    int projShareCount = 0
    int projDollarCount = 0
    if sessionUsable and elapsedMs > 0
        // Today's cumulative numerator is the live regular-session daily volume, as on 1D.
        if rvat_mode == 'Cumulative from open'
            today := volume
        else if resolutionCompatible
            int currentBlockStart = sessionStart + blockStartElapsed
            int currentDataStatus = f_sessionDataStatus(eVols, eStarts, eEnds, eNativeVolume, eNativeReady, sessionStart, sessionEnd)
            float volumeBeforeBlock = currentBlockStart == sessionStart ? 0.0 : currentDataStatus == 0 ? nz(f_windowSum(eVols, eStarts, eEnds, sessionStart, currentBlockStart), 0.0) : na
            if sessionComplete
                float currentRawFull = f_windowSum(eVols, eStarts, eEnds, sessionStart, sessionEnd)
                float scaledBeforeBlock = currentBlockStart == sessionStart ? 0.0 : not na(volumeBeforeBlock) and not na(currentRawFull) and currentRawFull > 0 ? volume * math.min(math.max(volumeBeforeBlock / currentRawFull, 0.0), 1.0) : na
                today := not na(scaledBeforeBlock) ? math.max(volume - scaledBeforeBlock, 0.0) : na
            else
                today := not na(volumeBeforeBlock) ? math.max(volume - volumeBeforeBlock, 0.0) : na
        if not na(eFSO) and eFSO > 0
            intensity := 100.0 * volume / eFSO
        float rvatSum = 0.0
        float rvatFullSum = 0.0
        float projShareFractionSum = 0.0
        float projDollarFractionSum = 0.0
        float reportedLess = 0.0
        float reportedEqual = 0.0
        float volumeLess = 0.0
        float volumeEqual = 0.0
        float adrProgressSum = 0.0
        int maxHistory = math.min(scanLimit, bar_index)
        if maxHistory > 0
            for i = 1 to maxHistory
                bool needRvat = rvatCount < rvat_len and resolutionCompatible
                bool needParticipation = collectReported and reportedCount < participation_len and not na(intensity)
                bool needVolumeParticipation = collectVolume and volumeCount < participation_len
                bool needAdr = adrCount < adr_pace_len
                bool needProjShares = projShareCount < len
                bool needProjDollar = projDollarCount < dollar_vol_len
                if not needRvat and not needParticipation and not needVolumeParticipation and not needAdr and not needProjShares and not needProjDollar
                    break
                int historicalStart = time[i]
                int historicalEnd = time_close[i]
                if na(historicalStart)
                    break
                scanned := i
                float historicalDailyVolume = volume[i]
                bool historicalBoundsValid = f_sessionBoundsValid(historicalStart, historicalEnd)
                int historicalSessionMs = historicalBoundsValid ? historicalEnd - historicalStart : 0
                bool historicalDailyValid = historicalBoundsValid and historicalEnd <= sessionStart and not na(historicalDailyVolume) and historicalDailyVolume >= 0
                bool historicalReachesTarget = sessionComplete or historicalSessionMs >= elapsedMs
                if not historicalDailyValid
                    badDaily += 1
                else if not historicalReachesTarget
                    shortSessions += 1
                else
                    int historicalTarget = sessionComplete ? historicalEnd : historicalStart + elapsedMs
                    bool historicalAtClose = sessionComplete
                    bool reportedZeroDay = historicalDailyVolume == 0
                    bool needsIntradayPath = not historicalAtClose or (needRvat and rvat_mode == 'Per-block')
                    int dataStatus = needsIntradayPath and not reportedZeroDay ? f_sessionDataStatus(eVols[i], eStarts[i], eEnds[i], eNativeVolume[i], eNativeReady[i], historicalStart, historicalEnd) : 0
                    bool pathUsable = dataStatus == 0
                    if dataStatus == 1
                        noIntrabars += 1
                    else if dataStatus == 2
                        sourceBoundary += 1
                    else if dataStatus == 3
                        malformed += 1
                    else if dataStatus == 4
                        mismatch += 1
                    if needsIntradayPath and pathUsable and not reportedZeroDay
                        int firstHistoricalPrint = f_firstTimestamp(eStarts[i])
                        int lastHistoricalPrintEnd = f_lastTimestamp(eEnds[i])
                        if firstHistoricalPrint - historicalStart > 60000 or historicalEnd - lastHistoricalPrintEnd > 60000
                            sparseAccepted += 1
                    float historicalCumulative = reportedZeroDay ? 0.0 : historicalAtClose ? historicalDailyVolume : pathUsable ? f_scaledHistoricalWindow(eVols[i], eStarts[i], eEnds[i], historicalStart, historicalStart, historicalTarget, historicalEnd, historicalDailyVolume) : na
                    if not historicalAtClose and not na(historicalCumulative) and historicalCumulative == 0
                        zeroWindows += 1
                    // Independent intraday-seasonal completion profiles. The per-block
                    // RVOL mode must NOT dictate the full-session projection.
                    if needProjShares and historicalDailyVolume > 0 and not na(historicalCumulative)
                        projShareFractionSum += math.min(math.max(historicalCumulative / historicalDailyVolume, 0.0), 1.0)
                        projShareCount += 1
                    if needProjDollar and pathUsable and not reportedZeroDay and not na(ePVs[i])
                        float fullNotional = f_windowSum(ePVs[i], eStarts[i], eEnds[i], historicalStart, historicalEnd)
                        float toTimeNotional = f_windowSum(ePVs[i], eStarts[i], eEnds[i], historicalStart, historicalTarget)
                        if not na(fullNotional) and fullNotional > 0 and not na(toTimeNotional)
                            projDollarFractionSum += math.min(math.max(toTimeNotional / fullNotional, 0.0), 1.0)
                            projDollarCount += 1
                    if needRvat
                        float historicalRvat = na
                        if rvat_mode == 'Cumulative from open'
                            historicalRvat := historicalCumulative
                        else
                            int historicalBlockStart = historicalStart + blockStartElapsed
                            if historicalBlockStart < historicalTarget and historicalBlockStart < historicalEnd
                                historicalRvat := reportedZeroDay ? 0.0 : pathUsable ? f_scaledHistoricalWindow(eVols[i], eStarts[i], eEnds[i], historicalStart, historicalBlockStart, historicalTarget, historicalEnd, historicalDailyVolume) : na
                        if not na(historicalRvat)
                            rvatSum += historicalRvat
                            rvatFullSum += historicalDailyVolume
                            rvatCount += 1
                            rvatOldest := historicalStart
                            rvatOldestBack := i
                            if na(rvatNewest)
                                rvatNewest := historicalStart
                    if needParticipation and not na(historicalCumulative)
                        float historicalFloat = eFloatFY[i]
                        if not na(historicalFloat) and historicalFloat > 0
                            float historicalParticipation = 100.0 * historicalCumulative / historicalFloat
                            float tieTolerance = math.max(math.abs(intensity), 1.0) * 0.0000001
                            if historicalParticipation < intensity - tieTolerance
                                reportedLess += 1.0
                            else if math.abs(historicalParticipation - intensity) <= tieTolerance
                                reportedEqual += 1.0
                            reportedCount += 1
                            reportedOldest := historicalStart
                            reportedOldestBack := i
                            if na(reportedNewest)
                                reportedNewest := historicalStart
                        else
                            missingFloat += 1
                    if needVolumeParticipation and not na(historicalCumulative)
                        float volumeTieTolerance = math.max(math.abs(volume), 1.0) * 0.0000001
                        if historicalCumulative < volume - volumeTieTolerance
                            volumeLess += 1.0
                        else if math.abs(historicalCumulative - volume) <= volumeTieTolerance
                            volumeEqual += 1.0
                        volumeCount += 1
                        volumeOldest := historicalStart
                        volumeOldestBack := i
                        if na(volumeNewest)
                            volumeNewest := historicalStart
                    if needAdr and (historicalAtClose or pathUsable) and not reportedZeroDay
                        float historicalRangeProgress = na
                        if historicalAtClose
                            historicalRangeProgress := 1.0
                        else
                            [historicalFullHigh, historicalFullLow] = f_windowHighLow(eHighs[i], eLows[i], eStarts[i], eEnds[i], historicalStart, historicalEnd)
                            [historicalHighToTime, historicalLowToTime] = f_windowHighLow(eHighs[i], eLows[i], eStarts[i], eEnds[i], historicalStart, historicalTarget)
                            float historicalFullRange = not na(historicalFullHigh) and not na(historicalFullLow) ? historicalFullHigh - historicalFullLow : na
                            if not na(historicalFullRange) and historicalFullRange > 0 and not na(historicalHighToTime) and not na(historicalLowToTime)
                                historicalRangeProgress := math.min(math.max((historicalHighToTime - historicalLowToTime) / historicalFullRange, 0.0), 1.0)
                        if not na(historicalRangeProgress) and historicalRangeProgress > 0
                            adrProgressSum += historicalRangeProgress
                            adrCount += 1
                            adrOldest := historicalStart
                            adrOldestBack := i
                            if na(adrNewest)
                                adrNewest := historicalStart
                        else
                            noRange += 1
        if rvatCount >= 21
            rvatAvg := rvatSum / rvatCount
            rvatFullAvg := rvatFullSum / rvatCount
            rvatCompletion := rvatFullAvg > 0 ? rvatAvg / rvatFullAvg : na
            bool rvatArithmeticValid = rvat_mode != 'Cumulative from open' or (not na(rvatCompletion) and rvatCompletion >= 0 and rvatCompletion <= 1.000001)
            if not rvatArithmeticValid
                rvatAvg := na
                rvatCompletion := na
        reportedPctile := reportedCount >= 63 ? 100.0 * (reportedLess + 0.5 * reportedEqual) / reportedCount : na
        volumePctile := volumeCount >= 63 ? 100.0 * (volumeLess + 0.5 * volumeEqual) / volumeCount : na
        adrProgressAvg := adrCount >= 21 ? adrProgressSum / adrCount : na
        projShareFraction := projShareCount >= 21 ? projShareFractionSum / projShareCount : na
        projDollarFraction := projDollarCount >= 21 ? projDollarFractionSum / projDollarCount : na
    IntradayDailyEngine.new(sessionStart = sessionStart, cutoff = cutoff, elapsedMs = elapsedMs, firstThirtyVolume = firstThirtyVolume, today = today, intensity = intensity, rvatAverage = rvatAvg, rvatFullDayAvg = rvatFullAvg, rvatCompletion = rvatCompletion, projectionShareCompletion = projShareFraction, projectionDollarCompletion = projDollarFraction, projectionSharesN = projShareCount, projectionDollarN = projDollarCount, reportedPctile = reportedPctile, volumePctile = volumePctile, adrProgressAvg = adrProgressAvg, rvatCount = rvatCount, reportedCount = reportedCount, volumeCount = volumeCount, adrCount = adrCount, scanned = scanned, badDaily = badDaily, shortSessions = shortSessions, noIntrabars = noIntrabars, sourceBoundary = sourceBoundary, malformed = malformed, mismatch = mismatch, missingFloat = missingFloat, noRange = noRange, sparseAccepted = sparseAccepted, zeroWindows = zeroWindows, rvatOldest = rvatOldest, rvatNewest = rvatNewest, rvatOldestBack = rvatOldestBack, reportedOldest = reportedOldest, reportedNewest = reportedNewest, reportedOldestBack = reportedOldestBack, volumeOldest = volumeOldest, volumeNewest = volumeNewest, volumeOldestBack = volumeOldestBack, adrOldest = adrOldest, adrNewest = adrNewest, adrOldestBack = adrOldestBack)
IntradayDailyEngine iEngine = request.security(regularTicker, '1D', f_iDailyEngine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=tfIntraday ? 100000 : 2)
// The mirror is used only when it describes the same regular session as the daily feed.
bool iEngineAligned = false
if tfIntraday and not na(iEngine)
    iEngineAligned := not na(iEngine.cutoff) and iEngine.sessionStart == rvatDailyStart

int rvatCutoff = na
float rvatElapsedMinutes = na
float rvatSessionProgress = na
int rvatElapsedMs = 0
int rvatSessionMs = 0
int rvatBlockMs = rvat_block_min * 60 * 1000
int rvatBlockIndex = 0
int rvatBlockStartElapsed = 0
int rvatSamplingMs = int(timeframe.in_seconds(rvat_intratf) * 1000)
// Scan at most twice the maximum requested sample, capped at 3,000 chart bars.
// TradingView source-bar budgets can independently shorten valid same-time history.
// Valid n, inspected bars and exclusions are exposed; a requested 1,260 n is not invented.
int sameTimeScanLimit = math.min(3000, 2 * math.max(math.max(math.max(rvat_len, participation_len), adr_pace_len), math.max(len, dollar_vol_len)))
bool rvatResolutionCompatible = rvat_mode == 'Cumulative from open' or rvatSamplingMs <= rvatBlockMs
// ticker.new(..., session.regular) is requested above, so its daily time/time_close values are
// the authoritative regular-session boundaries. Do not re-anchor them to the first print: an
// illiquid symbol may simply have no trade at the bell.
int currentSessionStart = rvatDailyStart
int currentSessionEnd = rvatDailyEnd
bool currentSessionBoundsValid = f_sessionBoundsValid(currentSessionStart, currentSessionEnd)
bool advancedDailyReady = timeframe.isdaily and timeframe.multiplier == 1 and currentSessionBoundsValid and not na(rvatDailyVolume)
bool rvatSessionActive = advancedDailyReady and timenow >= currentSessionStart and timenow < currentSessionEnd
bool rvatSessionComplete = advancedDailyReady and timenow >= currentSessionEnd
bool rvatSessionUsable = rvatSessionActive or rvatSessionComplete
if barstate.islast and rvatSessionUsable
    rvatSessionMs := currentSessionEnd - currentSessionStart
    // Always use the actual script clock during an open session. The previous build sometimes
    // treated the latest daily bar as complete and therefore compared an intraday numerator with
    // full-day history. The clamp prevents pre-open or post-close leakage.
    rvatCutoff := rvatSessionActive ? math.min(math.max(timenow, currentSessionStart + 1), currentSessionEnd - 1) : currentSessionEnd
    rvatElapsedMs := math.max(rvatCutoff - currentSessionStart, 0)
    rvatElapsedMinutes := float(rvatElapsedMs) / 60000.0
    rvatSessionProgress := rvatSessionMs > 0 ? float(rvatElapsedMs) / float(rvatSessionMs) : na
    int firstThirtyEnd = math.min(currentSessionStart + 30 * 60 * 1000, currentSessionEnd)
    float firstThirtyVolume = rvatElapsedMs <= 30 * 60 * 1000 ? rvatDailyVolume : f_windowSum(rvatIntraVols, rvatIntraStarts, rvatIntraEnds, currentSessionStart, firstThirtyEnd)
    relVolExceeded50InFirst30Min := not na(firstThirtyVolume) and not na(ma) and ma > 0 and 100.0 * firstThirtyVolume / ma > 50.0
    if rvatElapsedMs > 0 and rvatBlockMs > 0
        int elapsedForBlock = rvatElapsedMs >= rvatSessionMs and rvatSessionMs > 0 ? rvatSessionMs - 1 : rvatElapsedMs
        rvatBlockIndex := int(math.floor(float(math.max(elapsedForBlock, 0)) / float(rvatBlockMs)))
        rvatBlockStartElapsed := rvatBlockIndex * rvatBlockMs
float rvatToday = na
float rvatAverage = na
float rvatRatio = na
float rvatValue = na
float participationIntensity = na
float participationPctile = na
int rvatSampleCount = 0
int participationSampleCount = 0
int participationReportedCount = 0
float participationReportedPctile = na
int participationVolumeCount = 0
float participationVolumePctile = na
bool participationUsesVolumeProxy = false
int participationVolumeOldestStart = na
int participationVolumeNewestStart = na
int participationVolumeOldestOffset = 0
bool participationCollectReported = participation_basis != 'Same-time volume only'
bool participationCollectVolume = participation_basis != 'Reported historical float only'
float sessionDollarVolume = na
float sessionVWAP = na
float economicThroughput = na
float dayRangePosition = na
float directionalEfficiency = na
float distanceFromVWAP = na
float priceImpactPerTurnover = na
float adrPaceAtTime = na
float adrRangeProgressAvg = na
int adrPaceSampleCount = 0
float rvatHistoricalFullDayAvg = na
float rvatHistoricalCompletion = na
float projectionShareCompletion = na
float projectionDollarCompletion = na
int projectionShareN = 0
int projectionDollarN = 0
// Diagnostics do not alter table layout. Counts refer to candidates inspected while filling
// the independent samples; a rejection category may apply to only one of the metrics.
int historyScanned = 0
int historyBadDaily = 0
int historyShortSessions = 0
int historyNoIntrabars = 0
int historySourceBoundary = 0
int historyMalformed = 0
int historyCumulativeMismatch = 0
int historyMissingFloat = 0
int historyNoRange = 0
int historySparseAccepted = 0
int historyZeroWindows = 0
int rvatOldestStart = na
int participationOldestStart = na

        economicThroughput := not na(freeFloatMarketCapNow) and freeFloatMarketCapNow > 0 ? 100.0 * sessionDollarVolume / freeFloatMarketCapNow : na
        dayRangePosition := rvatDailyHigh > rvatDailyLow ? 100.0 * (rvatDailyClose - rvatDailyLow) / (rvatDailyHigh - rvatDailyLow) : na
        directionalEfficiency := rvatDailyHigh > rvatDailyLow ? 100.0 * (rvatDailyClose - rvatDailyOpen) / (rvatDailyHigh - rvatDailyLow) : na
        distanceFromVWAP := not na(sessionVWAP) and sessionVWAP > 0 ? 100.0 * (rvatDailyClose / sessionVWAP - 1.0) : na
        float priceImpactReturn = price_impact_basis == 'Open to current' ? (rvatDailyOpen > 0 ? 100.0 * (rvatDailyClose / rvatDailyOpen - 1.0) : na) : (rvatPreviousClose > 0 ? 100.0 * (rvatDailyClose / rvatPreviousClose - 1.0) : na)
        priceImpactPerTurnover := not na(participationIntensity) and participationIntensity > 0 ? priceImpactReturn / participationIntensity : na

            float scaledBeforeBlock = currentBlockStart == currentSessionStart ? 0.0 : not na(volumeBeforeBlock) and not na(currentRawFull) and currentRawFull > 0 ? rvatDailyVolume * math.min(math.max(volumeBeforeBlock / currentRawFull, 0.0), 1.0) : na
            rvatToday := not na(scaledBeforeBlock) ? math.max(rvatDailyVolume - scaledBeforeBlock, 0.0) : na

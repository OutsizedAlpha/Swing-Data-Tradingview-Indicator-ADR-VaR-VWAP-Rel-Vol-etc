if barstate.islast and tfIntraday
    advancedDailyReady := currentSessionBoundsValid and not na(rvatDailyVolume)
    rvatSessionActive := advancedDailyReady and timenow >= currentSessionStart and timenow < currentSessionEnd
    rvatSessionComplete := advancedDailyReady and timenow >= currentSessionEnd

// ============================================================================
// MULTI-SESSION ENGINE: 2D+, W, M and their TradingView-supported multiples.
// The original 1D engine above is left in place. This branch only runs on >1D.
// ============================================================================
int hScanned = 0
int hBadPeriod = 0
int hNoPath = 0
int hClipped = 0
int hBadPath = 0
int hBadDays = 0
int hTooShort = 0
int hMissingFloat = 0
int hNoRange = 0
int hShareProjectionCount = 0
int hDollarProjectionCount = 0
float hShareAverage = na
float hShareCompletion = na
float hDollarAverage = na
float hDollarCompletion = na
float hProjectedVolume = na
float hProjectedDollarVolume = na
float hCurrentDollarVolume = na
float hPosition = na
float hBlockLo = na
float hBlockHi = na
float hDayFraction = na
int hCutoff = na
bool hComplete = tfHigher and not na(hPeriodEnd) and timenow >= hPeriodEnd
bool hCalendarMatches = not na(hCalendarKey) and hCalendarKey == hPeriodStart and hCalendarReady and not na(hDayCount) and hDayCount > 0
bool hPeriodValid = tfHigher and not na(hPeriodStart) and not na(hPeriodEnd) and hPeriodEnd > hPeriodStart and not na(hPeriodVolume) and hPeriodVolume >= 0
bool hUsable = hPeriodValid and timenow > hPeriodStart
bool hPathCompatible = rvat_mode == 'Cumulative from open' or hSamplingSeconds <= float(rvat_block_min * 60)
string hStatusText = ''
string hProjectionTooltip = ''
string hDollarProjectionTooltip = ''
string hVwapTooltip = ''

if barstate.islast and tfHigher
    // Current OHLCV always comes from the CHART PERIOD, never the last daily bar.
    if hUsable
        hCutoff := math.min(timenow, hPeriodEnd)
        if hCalendarMatches and hCalendarDayEnd > hCalendarDayStart
            hDayFraction := math.min(math.max(float(timenow - hCalendarDayStart) / float(hCalendarDayEnd - hCalendarDayStart), 0.0), 1.0)
            hPosition := float(hDayCount - 1) + hDayFraction
            float elapsedSeconds = float(hCalendarDayEnd - hCalendarDayStart) / 1000.0 * hDayFraction
            float durationSeconds = float(hCalendarDayEnd - hCalendarDayStart) / 1000.0
            float blockSeconds = float(rvat_block_min * 60)
            float insideSeconds = math.min(elapsedSeconds, math.max(durationSeconds - 0.001, 0.0))
            float blockStartSeconds = math.floor(math.max(insideSeconds, 0.0) / blockSeconds) * blockSeconds
            hBlockLo := float(hDayCount - 1) + blockStartSeconds / durationSeconds
            hBlockHi := hPosition
        // At the period close historical comparisons use each previous FULL period.
        if hComplete and hCalendarMatches
            hPosition := float(hDayCount)

        float expectedAdrToTime = not na(adrRangeProgressAvg) and adrRangeProgressAvg > 0 and arp > 0 ? arp * adrRangeProgressAvg : na
        adrPaceAtTime := not na(adrOpenToCurrent) and not na(expectedAdrToTime) and expectedAdrToTime > 0 ? adrOpenToCurrent / expectedAdrToTime : na
